# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=           # from @BotFather

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_USER_IDS=               # comma-separated Telegram user IDs of admins

# ── Google OAuth (device flow, TVs & Limited Input client type) ───────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=               # shared free-tier key
AI_MODEL_NAME=gemini-2.0-flash-lite   # model name only; no hard-coding in code
AI_FALLBACK_CHAIN=            # e.g. gemini-2.0-flash (comma-separated, optional)
AI_PER_USER_DAILY_CAP=3
AI_GLOBAL_DAILY_QUOTA=500
AI_GLOBAL_CEILING_PCT=80

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=/var/lib/squares-vault/db/squares.sqlite3

# ── Security ──────────────────────────────────────────────────────────────────
MASTER_KEY_PATH=/etc/squares-vault/master.key
TMP_DIR=/var/lib/squares-vault/tmp

# ── Backups (R2 primary, B2 secondary) ───────────────────────────────────────
BACKUP_R2_ENDPOINT=
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY=
BACKUP_R2_SECRET_KEY=
BACKUP_B2_ENDPOINT=
BACKUP_B2_BUCKET=
BACKUP_B2_ACCESS_KEY=
BACKUP_B2_SECRET_KEY=
BACKUP_AGE_RECIPIENT=         # age public key (e.g. age1...)

# ── Operations ────────────────────────────────────────────────────────────────
UPTIME_PING_URL=              # e.g. BetterUptime or Freshping heartbeat URL

# ── App settings ─────────────────────────────────────────────────────────────
MAX_USERS=100
POLICY_VERSION=1.0
DEFAULT_TZ=Asia/Kolkata
DEFAULT_REMIND_TIME=09:00

---
import testimonials from '../data/testimonials.json';

interface TestimonialItem {
  name: string;
  role: string;
  quote: string;
  location?: string;
}

const items = (testimonials as TestimonialItem[]) || [];
---

{items && items.length > 0 && (
  <section class="section" id="testimonials">
    <div class="container">
      <div class="section-header">
        <div class="section-kicker">User Experiences</div>
        <h2>What people say</h2>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
        {items.map((t) => (
          <div class="card-paper" style="display: flex; flex-direction: column; justify-content: space-between;">
            <p style="font-style: italic; font-size: 0.95rem; color: var(--muted); margin-bottom: 16px;">
              "{t.quote}"
            </p>
            <div>
              <strong style="color: var(--text); font-size: 0.92rem;">{t.name}</strong>
              <div style="color: var(--muted); font-size: 0.8rem;">
                {t.role} {t.location ? `· ${t.location}` : ''}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

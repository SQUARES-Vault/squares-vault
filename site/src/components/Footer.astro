---
import { siteConfig, getAssetUrl } from '../config';
import documents from '../data/documents.json';
import audiences from '../data/audiences.json';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-columns">
      <div class="footer-col" style="grid-column: span 1;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
          <img src={getAssetUrl('/logo-icon.png')} alt="" width="20" height="20" style="border-radius: 4px;" loading="lazy" decoding="async" />
          <strong style="font-size: 14px; font-weight: 600; color: var(--text);">{siteConfig.siteName}</strong>
        </div>
        <p style="font-size: 12px; color: var(--muted); line-height: 1.5; margin-bottom: 14px;">
          A private, zero-custodian document management assistant for Telegram.
          Files stored exclusively in your own Google Drive.
        </p>
        <p style="font-size: 12px; color: var(--muted); line-height: 1.5;">
          Built by <strong style="color: var(--text);">{siteConfig.builderName}</strong>.<br />
          Contact: <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
        </p>
      </div>

      <div class="footer-col">
        <h5>Document Types</h5>
        <ul>
          {documents.slice(0, 5).map((doc) => (
            <li><a href={getAssetUrl(`/documents/${doc.slug}/`)}>{doc.name}</a></li>
          ))}
          <li><a href={getAssetUrl('/#documents')} style="color: var(--accent);">View all 10 documents ›</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h5>For You</h5>
        <ul>
          {audiences.map((aud) => (
            <li><a href={getAssetUrl(`/for/${aud.slug}/`)}>{aud.title}</a></li>
          ))}
          <li><a href={getAssetUrl('/vs/digilocker/')}>vs. DigiLocker</a></li>
          <li><a href={getAssetUrl('/vs/google-drive/')}>vs. Drive Alone</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h5>Resources &amp; Beta</h5>
        <ul>
          <li><a href={siteConfig.inviteEmailUrl} style="color: var(--accent); font-weight: 500;">Request Free Invite Code ›</a></li>
          <li><a href={getAssetUrl('/guides/')}>Guides &amp; Checklists</a></li>
          <li><a href={getAssetUrl('/about/')}>About the Project</a></li>
          <li><a href={getAssetUrl('/privacy.html')}>Privacy Policy</a></li>
          <li><a href={getAssetUrl('/terms.html')}>Terms of Service</a></li>
          <li><a href="https://ai.google.dev/terms" target="_blank" rel="noopener noreferrer">Google Gemini API Terms ↗</a></li>
          <li><a href={siteConfig.botUrl} target="_blank" rel="noopener noreferrer">Launch @squaresvaultbot ↗</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div>
        © {new Date().getFullYear()} SQUARES Vault. Zero-custodian document management. Currently in private beta.
      </div>
      <div style="display: flex; gap: 20px;">
        <a href={getAssetUrl('/privacy.html')}>Privacy Policy</a>
        <a href={getAssetUrl('/terms.html')}>Terms of Service</a>
        <a href={getAssetUrl('/hi/')}>हिन्दी संस्करण</a>
      </div>
    </div>
  </div>
</footer>

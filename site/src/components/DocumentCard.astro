---
import { getAssetUrl } from '../config';
import LucideIcon from './icons/LucideIcon.astro';

interface Props {
  title: string;
  category: string;
  iconName?: string;
  slug: string;
  summary: string;
  validity?: string;
}

const { title, category, iconName = 'file-text', slug, summary, validity } = Astro.props;

const categoryClass = category.toLowerCase().includes('vehicle')
  ? 'vehicle'
  : category.toLowerCase().includes('health') || category.toLowerCase().includes('identity') || category.toLowerCase().includes('legal')
  ? 'identity'
  : 'home';
---

<div class="doc-card-custom">
  <div>
    <div class="doc-card-top">
      <span class={`doc-badge-pill ${categoryClass}`}>{category}</span>
      <div style="color: var(--accent); display: flex; align-items: center;">
        <LucideIcon name={iconName} size={18} />
      </div>
    </div>

    <h3 class="doc-card-title">
      <a href={getAssetUrl(`/documents/${slug}/`)}>
        {title}
      </a>
    </h3>

    <p class="doc-card-summary">
      {summary}
    </p>
  </div>

  <div style="padding-top: 12px; border-top: 1px solid var(--hairline); display: flex; align-items: center; justify-content: space-between;">
    {validity ? (
      <span style="font-size: 11.5px; color: var(--muted); font-weight: 500;">{validity}</span>
    ) : (
      <span style="font-size: 11.5px; color: var(--muted);">Direct to Drive</span>
    )}
    <a href={getAssetUrl(`/documents/${slug}/`)} class="doc-card-link">
      <span>Read Guide</span>
      <span>→</span>
    </a>
  </div>
</div>

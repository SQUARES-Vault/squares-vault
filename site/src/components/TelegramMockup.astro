---
import { getAssetUrl } from '../config';
---

<div class="hero-mockup-floating">
  <div class="chat-header">
    <img
      src={getAssetUrl('/logo-icon.png')}
      alt="SQUARES Vault"
      class="chat-avatar"
      width="34"
      height="34"
      loading="eager"
      decoding="async"
    />
    <div>
      <div class="chat-title">SQUARES Vault</div>
      <div class="chat-subtitle">Verified Telegram Assistant</div>
    </div>
  </div>

  <div class="chat-stream">
    <div class="bubble bubble-user">
      Show me all documents for my Venue
    </div>

    <div class="bubble bubble-bot">
      <div style="font-weight: 600; font-size: 13px; color: var(--accent); margin-bottom: 4px;">
        Vault Assistant
      </div>
      <p style="font-size: 13px; color: var(--text); margin-bottom: 10px;">
        Found 3 linked records for <span class="badge-plate">UP15EB3XX3</span> <em>(Hyundai VENUE)</em>:
      </p>

      <div class="mock-doc-row">
        <div>
          <strong style="color: var(--text);">1. Vehicle Registration &amp; Title</strong>
          <div style="color: var(--muted); font-size: 12px;">Plate: UP15EB3XX3 · Verified</div>
        </div>
        <span class="badge-status active">Active</span>
      </div>

      <div class="mock-doc-row">
        <div>
          <strong style="color: var(--text);">2. Auto Insurance Policy</strong>
          <div style="color: var(--muted); font-size: 12px;">Expires 10 Nov 2026 · Comprehensive</div>
        </div>
        <span class="badge-status expiring">17 Days</span>
      </div>

      <div class="mock-doc-row">
        <div>
          <strong style="color: var(--text);">3. Safety &amp; Emissions Inspection</strong>
          <div style="color: var(--muted); font-size: 12px;">Annual Certificate · Valid</div>
        </div>
        <span class="badge-status active">Valid</span>
      </div>

      <div class="mock-btn-row">
        <div class="mock-btn">View Documents (3)</div>
        <div class="mock-btn" style="color: var(--muted); background-color: var(--surface);">End Chat</div>
      </div>
    </div>
  </div>
</div>

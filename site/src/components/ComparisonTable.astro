---
import LucideIcon from './icons/LucideIcon.astro';
---

<div class="table-wrapper">
  <table class="comparison-table">
    <thead>
      <tr>
        <th style="width: 25%;">Capability</th>
        <th style="width: 27%; color: var(--accent-pine); font-weight: 700;">SQUARES Vault</th>
        <th style="width: 24%;">DigiLocker</th>
        <th style="width: 24%;">Google Drive Folders</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="col-feature">Primary Role</td>
        <td class="col-vault">Proactive life-admin & expiry assistant</td>
        <td>Official government document depository</td>
        <td>General cloud file storage</td>
      </tr>
      <tr>
        <td class="col-feature">Document Scope</td>
        <td class="col-vault">Any document (warranties, bills, receipts, insurance, RC)</td>
        <td>Government-issued digital certificates</td>
        <td>Any file uploaded manually</td>
      </tr>
      <tr>
        <td class="col-feature">AI Extraction</td>
        <td class="col-vault">Reads dates, policy numbers, amounts via Gemini API</td>
        <td>Reads issuer metadata via national APIs</td>
        <td>Manual indexing / text OCR only</td>
      </tr>
      <tr>
        <td class="col-feature">Automated Expiry Alerts</td>
        <td class="col-vault">Automated 10-day, 2-day & same-day Telegram reminders</td>
        <td>Limited or issuer-dependent</td>
        <td>None (Requires manual calendar creation)</td>
      </tr>
      <tr>
        <td class="col-feature">Original File Storage</td>
        <td class="col-vault">Stored directly in your own Google Drive</td>
        <td>Stored in Government of India cloud</td>
        <td>Stored in your Google Drive</td>
      </tr>
      <tr>
        <td class="col-feature">Vehicle Multi-Hop Linking</td>
        <td class="col-vault">Links RC, insurance, PUC, challan by plate</td>
        <td>Separate issuer cards</td>
        <td>Manual folder sorting</td>
      </tr>
      <tr>
        <td class="col-feature">Access Method</td>
        <td class="col-vault">Telegram chat (@squaresvaultbot)</td>
        <td>DigiLocker app / Web portal</td>
        <td>Google Drive app / Web</td>
      </tr>
    </tbody>
  </table>
</div>

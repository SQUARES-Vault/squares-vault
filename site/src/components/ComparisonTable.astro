---
interface Props {
  currentLang?: 'en' | 'hi';
}

const { currentLang = 'en' } = Astro.props;
const isHi = currentLang === 'hi';
---

<div class="table-wrapper-apple">
  <table class="comparison-table-apple">
    <thead>
      <tr>
        <th style="width: 25%;">{isHi ? 'क्षमता / फ़ीचर' : 'Capability'}</th>
        <th style="width: 29%; color: var(--accent); font-weight: 600;">SQUARES Vault</th>
        <th style="width: 23%;">{isHi ? 'क्लाउड फ़ोल्डर (Drive / Dropbox)' : 'Cloud Folders (Drive / Dropbox)'}</th>
        <th style="width: 23%;">{isHi ? 'सरकारी पोर्टल (जैसे DigiLocker)' : 'Government Portals (e.g. DigiLocker)'}</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="col-feature">{isHi ? 'मुख्य उद्देश्य' : 'Primary Purpose'}</td>
        <td class="col-vault"><span class="check-accent">✓</span> {isHi ? 'सक्रिय लाइफ़-एडमिन और स्वचालित एक्सपायरी अलर्ट' : 'Proactive life-admin & automated expiry alerts'}</td>
        <td><span class="dash-muted">—</span> {isHi ? 'निष्क्रिय फ़ाइल स्टोरेज और मैन्युअल बैकअप' : 'Passive file storage & manual backup'}</td>
        <td><span class="dash-muted">—</span> {isHi ? 'आधिकारिक सरकारी पहचान पत्र रिपॉजिटरी' : 'Official government credential repository'}</td>
      </tr>
      <tr>
        <td class="col-feature">{isHi ? 'समर्थित दस्तावेज़' : 'Document Scope'}</td>
        <td class="col-vault"><span class="check-accent">✓</span> {isHi ? 'कोई भी कागज़ या PDF: वारंटी, निजी बीमा, रेंट एग्रीमेंट, बिल' : 'Any paper or PDF: warranties, private insurance, leases, bills, titles'}</td>
        <td><span class="dash-muted">—</span> {isHi ? 'मैन्युअल अपलोड की गई कोई भी फ़ाइल' : 'Any file uploaded manually'}</td>
        <td><span class="dash-muted">—</span> {isHi ? 'केवल सरकार द्वारा जारी प्रमाणपत्रों तक सीमित' : 'Limited strictly to state-issued IDs & certificates'}</td>
      </tr>
      <tr>
        <td class="col-feature">{isHi ? 'AI द्वारा डेटा निष्कर्षण' : 'AI Extraction & Indexing'}</td>
        <td class="col-vault"><span class="check-accent">✓</span> {isHi ? 'इन-मेमोरी Gemini AI द्वारा तारीख़, पॉलिसी नंबर और रकम की पहचान' : 'In-memory Gemini AI reading of dates, amounts, policy numbers'}</td>
        <td><span class="dash-muted">—</span> {isHi ? 'मैन्युअल नाम बदलना / केवल बेसिक कीवर्ड सर्च' : 'Manual renaming / keyword search only'}</td>
        <td><span class="dash-muted">—</span> {isHi ? 'केवल सरकारी API से प्राप्त रीड-ओनली मेटाडेटा' : 'Read-only issuer metadata via government APIs'}</td>
      </tr>
      <tr>
        <td class="col-feature">{isHi ? 'स्वचालित एक्सपायरी अलर्ट' : 'Automated Expiry Alerts'}</td>
        <td class="col-vault"><span class="check-accent">✓</span> {isHi ? 'टेलीग्राम पर 10-दिन, 2-दिन और अंतिम दिन मल्टी-स्टेज अलर्ट' : 'Multi-stage 10-day, 2-day & same-day Telegram reminders'}</td>
        <td><span class="dash-muted">—</span> {isHi ? 'कोई नहीं (कैलेंडर में अलग से डालना पड़ता है)' : 'None (Requires manual calendar entries)'}</td>
        <td><span class="dash-muted">—</span> {isHi ? 'कोई नहीं या पोर्टल पर निर्भर' : 'None or platform-dependent'}</td>
      </tr>
      <tr>
        <td class="col-feature">{isHi ? 'मूल फ़ाइल का भंडारण' : 'Original File Storage'}</td>
        <td class="col-vault"><span class="check-accent">✓</span> {isHi ? 'सीधे आपके निजी Google Drive में सुरक्षित (ज़ीरो सर्वर कस्टडी)' : 'Stored directly in your own Google Drive (Zero server custody)'}</td>
        <td><span class="check-accent">✓</span> {isHi ? 'आपके अपने क्लाउड खाते में सुरक्षित' : 'Stored in your own cloud account'}</td>
        <td><span class="dash-muted">—</span> {isHi ? 'सरकारी क्लाउड सर्वर में स्टोर' : 'Stored in government cloud infrastructure'}</td>
      </tr>
      <tr>
        <td class="col-feature">{isHi ? 'वाहन मल्टी-हॉप लिंकिंग' : 'Vehicle Multi-Hop Linking'}</td>
        <td class="col-vault"><span class="check-accent">✓</span> {isHi ? 'गाड़ी के नंबर से आरसी, बीमा, पीयूसी और चालान स्वतः लिंक' : 'Auto-links registration, insurance, inspections & tickets by plate'}</td>
        <td><span class="dash-muted">—</span> {isHi ? 'अलग-अलग फ़ोल्डर बनाकर मैन्युअल छाँटना ज़रूरी' : 'Manual folder sorting required'}</td>
        <td><span class="dash-muted">—</span> {isHi ? 'अलग-अलग असंबंधित दस्तावेज़ कार्ड' : 'Separate unlinked document cards'}</td>
      </tr>
      <tr>
        <td class="col-feature">{isHi ? 'संवादात्मक सवाल-जवाब' : 'Interactive Querying'}</td>
        <td class="col-vault"><span class="check-accent">✓</span> {isHi ? 'टेलीग्राम में सामान्य भाषा में पूछें ("इस महीने क्या रिन्यू होना है?")' : 'Conversational Q&A in Telegram ("What is due this month?")'}</td>
        <td><span class="dash-muted">—</span> {isHi ? 'केवल फ़ाइल नाम से साधारण खोज' : 'Basic keyword search only'}</td>
        <td><span class="dash-muted">—</span> {isHi ? 'कोई सुविधा नहीं' : 'None'}</td>
      </tr>
    </tbody>
  </table>
</div>

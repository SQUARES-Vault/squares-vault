---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TelegramMockup from '../../components/TelegramMockup.astro';
import VideoPlaceholder from '../../components/VideoPlaceholder.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import Testimonials from '../../components/Testimonials.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import DocumentCard from '../../components/DocumentCard.astro';
import LucideIcon from '../../components/icons/LucideIcon.astro';
import documents from '../../data/documents.json';
import audiences from '../../data/audiences.json';
import { siteConfig, getAssetUrl } from '../../config';

const hindiFaqs = [
  {
    q: 'क्या SQUARES Vault का इस्तेमाल पूरी तरह मुफ़्त है?',
    a: siteConfig.pricingNotice,
  },
  {
    q: 'मेरी असली फ़ाइलें और दस्तावेज़ कहाँ सेव होते हैं?',
    a: 'SQUARES Vault ज़ीरो-कस्टोडियन (Zero-Custodian) सिद्धांत पर काम करता है। हम आपकी कोई भी असली फ़ाइल अपने सर्वर पर हमेशा के लिए स्टोर नहीं करते। आपके सभी दस्तावेज़ सीधे आपके निजी <strong>Google Drive</strong> खाते में <code>SQUARES Vault</code> फ़ोल्डर में सुरक्षित रूप से सेव होते हैं।',
  },
  {
    q: 'SQUARES Vault मेरे Google Drive तक कैसे पहुँचता है?',
    a: 'सेटअप के दौरान आप Google के आधिकारिक डिवाइस फ़्लो से अनुमति देते हैं। हम केवल एक सीमित अनुमति (<code>drive.file</code>) माँगते हैं, जिससे बॉट सिर्फ़ उन्हीं फ़ाइलों को देख और प्रबंधित कर सकता है जो उसने खुद बनाई हैं। बॉट आपके Google Drive के किसी अन्य फ़ोल्डर, फ़ाइल या फ़ोटो को कभी नहीं देख सकता।',
  },
  {
    q: 'AI मेरे दस्तावेज़ों का डेटा कैसे प्रोसेस करता है?',
    a: 'दस्तावेज़ों से तारीख़ें और विवरण पढ़ने के लिए Google Gemini API का उपयोग किया जाता है। प्रोसेसिंग केवल अस्थायी (in-memory) रूप से होती है। अधिक जानकारी के लिए <a href="https://ai.google.dev/terms" target="_blank" rel="noopener noreferrer">Google Gemini API Terms</a> देखें।',
  },
  {
    q: 'अगर मैं अपना सारा डेटा मिटाना चाहूँ तो क्या करूँ?',
    a: 'आप कभी भी टेलीग्राम में <code>/deletemydata</code> लिख सकते हैं। ऐसा करते ही हमारी डेटाबेस से आपका प्रोफ़ाइल और सारा इंडेक्स हमेशा के लिए मिटा दिया जाता है, Google OAuth अनुमति रद्द हो जाती है, और सभी रिमाइंडर बंद हो जाते हैं। आपके Google Drive में मौजूद आपकी असली फ़ाइलें पूरी तरह सुरक्षित रहती हैं।',
  },
  {
    q: 'क्या परिवार का कोई दूसरा सदस्य भी मेरे दस्तावेज़ देख सकता है?',
    a: 'नहीं, जब तक आप खुद अनुमति न दें। डिफ़ॉल्ट रूप से आपके दस्तावेज़ केवल आपके टेलीग्राम खाते से जुड़े होते हैं। यदि आप चाहें, तो फ़ैमिली एक्सेस शेयरिंग के ज़रिए अपने जीवनसाथी या बच्चों को विशिष्ट श्रेणियों (जैसे स्वास्थ्य बीमा या वारंटी) को देखने की अनुमति दे सकते हैं।',
  },
];
---

<BaseLayout
  title="SQUARES Vault — निजी लाइफ़-एडमिन और दस्तावेज़ एक्सपायरी असिस्टेंट"
  description="टेलीग्राम में अपनी गाड़ी की आरसी, इंश्योरेंस, वारंटी और बिल भेजें। AI तारीख़ें पढ़ेगा, एक्सपायरी से पहले सूचना देगा, और असली फ़ाइलें आपके निजी Google Drive में सुरक्षित रहेंगी।"
  canonicalPath="/hi/"
  currentLang="hi"
  hreflangEn="/"
  hreflangHi="/hi/"
>
  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section class="section" style="padding-top: 56px; padding-bottom: 64px;">
    <div class="container hero-grid">
      <div class="hero-content">
        <div class="hero-kicker">निजी लाइफ़-एडमिन · टेलीग्राम असिस्टेंट</div>
        <h1 style="line-height: 1.25;">घर और गाड़ी के ज़रूरी दस्तावेज़ संभालें।<br />तारीख़ निकलने से पहले अलर्ट पाएं।</h1>
        <p class="hero-subhead" style="font-size: 1.15rem; line-height: 1.65;">
          टेलीग्राम में अपनी आरसी, इंश्योरेंस पॉलिसी, वारंटी कार्ड या बिल भेजें। जेमिनी AI तारीख़ें पढ़ेगा, समय पर रिमाइंडर भेजेगा, और सभी असली फ़ाइलें सुरक्षित <strong>आपके अपने Google Drive</strong> में सेव रहेंगी।
        </p>

        <div class="hero-actions">
          <a href={siteConfig.botUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="padding: 14px 28px; font-size: 1.02rem;">
            <LucideIcon name="message-square" size={18} />
            <span>टेलीग्राम में शुरू करें (@squaresvaultbot)</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a href="#how-it-works" class="btn btn-secondary" style="padding: 14px 22px;">
            <span>देखें कैसे काम करता है</span>
          </a>
        </div>

        <div style="margin-top: 24px; display: flex; flex-wrap: wrap; gap: 20px; font-size: 0.88rem; color: var(--ink-secondary);">
          <div style="display: flex; align-items: center; gap: 6px;">
            <LucideIcon name="check-circle" size={15} color="var(--accent-pine)" />
            <span>फाइलें आपके अपने Google Drive में</span>
          </div>
          <div style="display: flex; align-items: center; gap: 6px;">
            <LucideIcon name="check-circle" size={15} color="var(--accent-pine)" />
            <span>कोई अलग ऐप डाउनलोड करने की ज़रूरत नहीं</span>
          </div>
          <div style="display: flex; align-items: center; gap: 6px;">
            <LucideIcon name="check-circle" size={15} color="var(--accent-pine)" />
            <span>अर्ली एक्सेस में पूरी तरह मुफ़्त</span>
          </div>
        </div>
      </div>

      <!-- Telegram Chat Mockup Side -->
      <div>
        <TelegramMockup />
      </div>
    </div>
  </section>

  <!-- ═══════════════════ DEMO VIDEO / INTERACTION SLOT ═══════════════════ -->
  <section class="section section-bordered" style="background-color: var(--bg-paper);">
    <div class="container">
      <div class="section-header">
        <span class="badge-status active">30 सेकंड का डेमो</span>
        <h2>कागज़ात ढूँढने की परेशानी हमेशा के लिए ख़त्म</h2>
        <p class="subhead">
          देखें कि कैसे केवल एक फ़ोटो भेजने से एक्सपायरी तारीख़ अपने-आप दर्ज हो जाती है और फ़ाइल आपके Google Drive में व्यवस्थित हो जाती है।
        </p>
      </div>

      <VideoPlaceholder />
    </div>
  </section>

  <!-- ═══════════════════ HOW IT WORKS (4 STEPS) ═══════════════════ -->
  <section class="section" id="how-it-works">
    <div class="container">
      <div class="section-header">
        <span class="badge-status active">सरल प्रक्रिया</span>
        <h2>यह कैसे काम करता है</h2>
        <p class="subhead">चार आसान चरणों में अपनी ज़िंदगी के सभी ज़रूरी कागज़ात व्यवस्थित करें।</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px;">
        <div class="card-paper" style="padding: 28px;">
          <div style="font-family: var(--font-serif); font-size: 2rem; color: var(--accent-pine); margin-bottom: 8px;">01</div>
          <h3 style="font-size: 1.18rem; margin-bottom: 8px;">टेलीग्राम में फ़ोटो या PDF भेजें</h3>
          <p style="font-size: 0.92rem; color: var(--ink-secondary); margin: 0; line-height: 1.6;">
            अपनी गाड़ी की आरसी, पॉल्यूशन (PUC) पर्ची, होम अप्लायंस का बिल या इंश्योरेंस पॉलिसी की तस्वीर <code>@squaresvaultbot</code> को भेजें।
          </p>
        </div>

        <div class="card-paper" style="padding: 28px;">
          <div style="font-family: var(--font-serif); font-size: 2rem; color: var(--accent-pine); margin-bottom: 8px;">02</div>
          <h3 style="font-size: 1.18rem; margin-bottom: 8px;">AI तुरंत तारीख़ें पहचानता है</h3>
          <p style="font-size: 0.92rem; color: var(--ink-secondary); margin: 0; line-height: 1.6;">
            जेमिनी AI दस्तावेज़ से गाड़ी नंबर, पॉलिसी नंबर, एक्सपायरी तारीख़ और राशि को सेकंडों में पहचान कर रिकॉर्ड बना देता है।
          </p>
        </div>

        <div class="card-paper" style="padding: 28px;">
          <div style="font-family: var(--font-serif); font-size: 2rem; color: var(--accent-pine); margin-bottom: 8px;">03</div>
          <h3 style="font-size: 1.18rem; margin-bottom: 8px;">Google Drive में सुरक्षित स्टोरेज</h3>
          <p style="font-size: 0.92rem; color: var(--ink-secondary); margin: 0; line-height: 1.6;">
            दस्तावेज़ की मूल प्रति आपके अपने Google Drive में <code>SQUARES Vault</code> फ़ोल्डर में सहेजी जाती है। हमारे सर्वर पर नहीं।
          </p>
        </div>

        <div class="card-paper" style="padding: 28px;">
          <div style="font-family: var(--font-serif); font-size: 2rem; color: var(--accent-pine); margin-bottom: 8px;">04</div>
          <h3 style="font-size: 1.18rem; margin-bottom: 8px;">समय से पहले रिमाइंडर पाएं</h3>
          <p style="font-size: 0.92rem; color: var(--ink-secondary); margin: 0; line-height: 1.6;">
            तारीख़ ख़त्म होने से 10 दिन पहले, 2 दिन पहले और उसी दिन टेलीग्राम पर सूचना पाएं ताकि कभी चालान या जुर्माना न भरना पड़े।
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ POPULAR DOCUMENTS SECTION ═══════════════════ -->
  <section class="section section-bordered" style="background-color: var(--bg-paper);">
    <div class="container">
      <div class="section-header">
        <span class="badge-status active">दस्तावेज़ सहायता</span>
        <h2>कौन-से दस्तावेज़ सहेज सकते हैं?</h2>
        <p class="subhead">गाड़ी के कागज़ात से लेकर घर के इलेक्ट्रॉनिक सामान के बिल तक—सब कुछ एक जगह।</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
        {documents.slice(0, 6).map((doc) => (
          <DocumentCard
            title={doc.name}
            category={doc.category}
            summary={doc.summary}
            slug={doc.slug}
            icon={doc.icon}
          />
        ))}
      </div>

      <div style="text-align: center; margin-top: 36px;">
        <a href={getAssetUrl('/guides/')} class="btn btn-secondary">
          <span>सभी 10 दस्तावेज़ प्रकार और गाइड देखें &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ FEATURES GRID ═══════════════════ -->
  <section class="section" id="features">
    <div class="container">
      <div class="section-header">
        <span class="badge-status active">मुख्य खूबियाँ</span>
        <h2>भरोसेमंद और सादगी भरा अनुभव</h2>
        <p class="subhead">कोई तामझाम नहीं। सिर्फ़ वही सुविधाएँ जो आपकी ज़िंदगी को आसान बनाती हैं।</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px;">
        <div class="card-paper" style="padding: 24px;">
          <div style="margin-bottom: 12px; color: var(--accent-pine);">
            <LucideIcon name="car" size={24} />
          </div>
          <h3 style="font-size: 1.15rem; margin-bottom: 8px;">मल्टी-हॉप गाड़ी ग्रुपिंग</h3>
          <p style="font-size: 0.92rem; color: var(--ink-secondary); margin: 0; line-height: 1.6;">
            गाड़ी की आरसी एक बार जोड़ें। इसके बाद उस गाड़ी का कोई भी इंश्योरेंस, PUC या चालान अपने-आप उस नंबर प्लेट से जुड़ जाता है।
          </p>
        </div>

        <div class="card-paper" style="padding: 24px;">
          <div style="margin-bottom: 12px; color: var(--accent-pine);">
            <LucideIcon name="bell" size={24} />
          </div>
          <h3 style="font-size: 1.15rem; margin-bottom: 8px;">तीन स्तर के सटीक रिमाइंडर</h3>
          <p style="font-size: 0.92rem; color: var(--ink-secondary); margin: 0; line-height: 1.6;">
            10 दिन पहले (तैयारी के लिए), 2 दिन पहले (कार्रवाई के लिए), और आखिरी दिन (अंतिम सूचना) टेलीग्राम पर अलर्ट। साथ में 1-टैप स्नूज़।
          </p>
        </div>

        <div class="card-paper" style="padding: 24px;">
          <div style="margin-bottom: 12px; color: var(--accent-pine);">
            <LucideIcon name="hard-drive" size={24} />
          </div>
          <h3 style="font-size: 1.15rem; margin-bottom: 8px;">आपके अपने Google Drive में स्टोर</h3>
          <p style="font-size: 0.92rem; color: var(--ink-secondary); margin: 0; line-height: 1.6;">
            फ़ाइलें आपके निजी ड्राइव में सेव होती हैं। अगर आप भविष्य में सेवा बंद भी कर दें, तो भी आपकी सारी फ़ाइलें आपके पास रहेंगी।
          </p>
        </div>

        <div class="card-paper" style="padding: 24px;">
          <div style="margin-bottom: 12px; color: var(--accent-pine);">
            <LucideIcon name="shield-check" size={24} />
          </div>
          <h3 style="font-size: 1.15rem; margin-bottom: 8px;">सीमित अधिकार (drive.file)</h3>
          <p style="font-size: 0.92rem; color: var(--ink-secondary); margin: 0; line-height: 1.6;">
            हम Google से सिर्फ़ वही एक्सेस माँगते हैं जिससे बॉट द्वारा बनाई गई फ़ाइलें ही देखी जा सकें। आपकी निजी तस्वीरें या अन्य फ़ोल्डर पूरी तरह सुरक्षित हैं।
          </p>
        </div>

        <div class="card-paper" style="padding: 24px;">
          <div style="margin-bottom: 12px; color: var(--accent-pine);">
            <LucideIcon name="users" size={24} />
          </div>
          <h3 style="font-size: 1.15rem; margin-bottom: 8px;">परिवार के साथ शेयरिंग</h3>
          <p style="font-size: 0.92rem; color: var(--ink-secondary); margin: 0; line-height: 1.6;">
            अस्पताल या सर्विस सेंटर पर खड़े होकर परिवार के व्हाट्सएप ग्रुप में कागज़ात ढूँढने की ज़रूरत नहीं। परिवार के सदस्यों को सीधे व्यू एक्सेस दें।
          </p>
        </div>

        <div class="card-paper" style="padding: 24px;">
          <div style="margin-bottom: 12px; color: var(--accent-pine);">
            <LucideIcon name="trash-2" size={24} />
          </div>
          <h3 style="font-size: 1.15rem; margin-bottom: 8px;">/deletemydata की आज़ादी</h3>
          <p style="font-size: 0.92rem; color: var(--ink-secondary); margin: 0; line-height: 1.6;">
            किसी भी समय टेलीग्राम में <code>/deletemydata</code> टाइप करें। डेटाबेस से आपका सारा रिकॉर्ड तुरंत और हमेशा के लिए साफ़ कर दिया जाता है।
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ COMPARISON TABLE ═══════════════════ -->
  <section class="section section-bordered" id="comparison" style="background-color: var(--bg-paper);">
    <div class="container">
      <div class="section-header">
        <span class="badge-status active">निष्पक्ष तुलना</span>
        <h2>DigiLocker या Google Drive से अलग क्यों?</h2>
        <p class="subhead">
          DigiLocker सरकारी प्रमाणपत्रों के लिए है। Google Drive फ़ाइलों को निष्क्रिय रखता है। SQUARES Vault हर कागज़ को पढ़कर समय पर याद दिलाता है।
        </p>
      </div>

      <ComparisonTable />

      <div style="margin-top: 24px; text-align: center;">
        <a href={getAssetUrl('/vs/digilocker/')} style="font-size: 0.95rem; color: var(--accent-pine); text-decoration: underline; margin-right: 24px;">
          DigiLocker के साथ पूरी तुलना पढ़ें &rarr;
        </a>
        <a href={getAssetUrl('/vs/google-drive/')} style="font-size: 0.95rem; color: var(--accent-pine); text-decoration: underline;">
          Google Drive के साथ पूरी तुलना पढ़ें &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ FAQS ═══════════════════ -->
  <section class="section" id="faq">
    <div class="container">
      <div class="section-header">
        <span class="badge-status active">अक्सर पूछे जाने वाले सवाल</span>
        <h2>सच्चे और साफ़ जवाब</h2>
        <p class="subhead">गोपनीयता, सुरक्षा और शुल्क से जुड़े आपके प्रमुख सवालों के जवाब।</p>
      </div>

      <div style="max-width: 820px; margin: 0 auto;">
        <FaqAccordion items={hindiFaqs} />
      </div>
    </div>
  </section>

  <!-- ═══════════════════ FINAL CALL TO ACTION ═══════════════════ -->
  <section class="section section-bordered" style="background-color: var(--bg-paper); text-align: center;">
    <div class="container" style="max-width: 700px;">
      <h2 style="font-size: 2.2rem; margin-bottom: 16px;">आज ही अपने कागज़ात संभालें</h2>
      <p style="font-size: 1.15rem; color: var(--ink-secondary); margin-bottom: 32px; line-height: 1.6;">
        कोई क्रेडिट कार्ड नहीं। कोई अलग ऐप डाउनलोड नहीं। बस टेलीग्राम खोलें और अपना पहला दस्तावेज़ भेजें।
      </p>

      <div style="display: flex; flex-direction: column; align-items: center; gap: 16px;">
        <a href={siteConfig.botUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="padding: 16px 36px; font-size: 1.05rem;">
          <LucideIcon name="message-square" size={20} />
          <span>टेलीग्राम में @squaresvaultbot खोलें</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
        <span style="font-size: 0.85rem; color: var(--ink-muted);">
          {siteConfig.pricingNotice}
        </span>
      </div>

      <div style="margin-top: 48px; border-top: 1px solid var(--border-hairline); padding-top: 36px;">
        <EmailCapture />
      </div>
    </div>
  </section>
</BaseLayout>

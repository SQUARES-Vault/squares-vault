---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TelegramMockup from '../../components/TelegramMockup.astro';
import VideoPlaceholder from '../../components/VideoPlaceholder.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import Testimonials from '../../components/Testimonials.astro';
import DocumentCard from '../../components/DocumentCard.astro';
import LucideIcon from '../../components/icons/LucideIcon.astro';
import documents from '../../data/documents.json';
import audiences from '../../data/audiences.json';
import { siteConfig, getAssetUrl } from '../../config';

const hindiFaqs = [
  {
    q: 'क्या SQUARES Vault का इस्तेमाल पूरी तरह मुफ़्त है?',
    a: siteConfig.pricingNotice,
  },
  {
    q: 'मेरी मूल फ़ाइलें और दस्तावेज़ कहाँ सुरक्षित रहते हैं?',
    a: 'SQUARES Vault ज़ीरो-कस्टोडियन (Zero-Custodian) आर्किटेक्चर पर काम करता है। हम आपकी कोई भी मूल फ़ाइल अपने सर्वर पर स्टोर नहीं करते। आपके सभी दस्तावेज़ सीधे आपके अपने निजी <strong>Google Drive</strong> खाते में <code>SQUARES Vault</code> फ़ोल्डर में सुरक्षित रूप से सहेजे जाते हैं।',
  },
  {
    q: 'SQUARES Vault मेरे Google Drive तक कैसे पहुँचता है?',
    a: 'सेटअप के दौरान आप Google के आधिकारिक डिवाइस फ़्लो से सुरक्षित रूप से अनुमति देते हैं। हम केवल एक अत्यंत सीमित अनुमति (<code>drive.file</code>) माँगते हैं, जिससे बॉट सिर्फ़ उन्हीं फ़ाइलों को प्रबंधित कर सकता है जो उसने खुद बनाई हैं। बॉट आपके Google Drive के किसी अन्य मौजूदा फ़ोल्डर, फ़ाइल या फ़ोटो को कभी नहीं देख सकता।',
  },
  {
    q: 'AI मेरे दस्तावेज़ों का डेटा कैसे प्रोसेस करता है?',
    a: 'दस्तावेज़ों से तारीख़ें और विवरण पढ़ने के लिए Google Gemini API का उपयोग किया जाता है। प्रोसेसिंग केवल अस्थायी (in-memory) रूप से होती है। अधिक जानकारी और विवरण के लिए <a href="https://ai.google.dev/terms" target="_blank" rel="noopener noreferrer">Google Gemini API Terms</a> देखें।',
  },
  {
    q: 'अगर मैं अपना सारा डेटा मिटाना चाहूँ तो क्या करूँ?',
    a: 'आप कभी भी टेलीग्राम में <code>/deletemydata</code> लिख सकते हैं। ऐसा करते ही हमारे डेटाबेस से आपका प्रोफ़ाइल और सारा इंडेक्स तुरंत मिटा दिया जाता है, Google OAuth अनुमति रद्द हो जाती है, और सभी रिमाइंडर बंद हो जाते हैं। आपके Google Drive में मौजूद आपकी असली फ़ाइलें पूरी तरह आपके पास सुरक्षित रहती हैं।',
  },
  {
    q: 'क्या परिवार का कोई दूसरा सदस्य भी मेरे दस्तावेज़ देख सकता है?',
    a: 'नहीं, जब तक आप खुद अनुमति न दें। डिफ़ॉल्ट रूप से आपके दस्तावेज़ केवल आपके टेलीग्राम खाते से जुड़े होते हैं। यदि आप चाहें, तो फ़ैमिली एक्सेस शेयरिंग के ज़रिए अपने जीवनसाथी या परिवार के सदस्यों को विशिष्ट श्रेणियों (जैसे स्वास्थ्य बीमा या वारंटी) को देखने की अनुमति दे सकते हैं।',
  },
];
---

<BaseLayout
  title="SQUARES Vault — निजी लाइफ़-एडमिन और दस्तावेज़ एक्सपायरी असिस्टेंट"
  description="टेलीग्राम में अपनी गाड़ी के कागज़ात, बीमा पॉलिसी, वारंटी कार्ड और बिल भेजें। AI तारीख़ें पढ़ेगा, एक्सपायरी से पहले समय पर अलर्ट देगा, और मूल फ़ाइलें सीधे आपके निजी Google Drive में सुरक्षित रहेंगी।"
  canonicalPath="/hi/"
  currentLang="hi"
  hreflangEn="/"
  hreflangHi="/hi/"
>
  <!-- ═══════════════════ 1. HERO (Expansive 2-Column Split) ═══════════════════ -->
  <section class="section hero-apple">
    <div class="container hero-grid">
      <div class="hero-content">
        <div class="hero-eyebrow">निजी लाइफ़-एडमिन · टेलीग्राम असिस्टेंट</div>
        <h1 class="hero-title">
          <span class="hero-line">आपके सभी ज़रूरी दस्तावेज़ व्यवस्थित।</span>
          <span class="hero-line">एक्सपायरी तारीख़ से पहले समय पर अलर्ट।</span>
        </h1>

        <p class="hero-subhead">
          गाड़ी का रजिस्ट्रेशन व टाइटल, मोटर व स्वास्थ्य बीमा, होम अप्लायंस वारंटी, रेंटल लीज़ और बिल टेलीग्राम में फॉरवर्ड करें।
          Gemini AI मुख्य तारीख़ें पढ़ता है, मूल फ़ाइलें सीधे <strong>आपके निजी Google Drive</strong> में सहेजता है, और किसी भी तारीख़ के ख़त्म होने से पहले आपको अलर्ट करता है।
        </p>

        <div class="hero-cta-cluster">
          <div class="hero-buttons-row">
            <a href={siteConfig.inviteEmailUrl} class="btn-apple-primary">
              <span>मुफ़्त इनवाइट कोड मांगें</span>
            </a>
            <a href={siteConfig.botUrl} target="_blank" rel="noopener noreferrer" class="link-apple">
              <span>टेलीग्राम में खोलें</span>
              <span class="chevron">›</span>
            </a>
            <a href="#how-it-works" class="link-apple">
              <span>देखें कैसे काम करता है</span>
              <span class="chevron">›</span>
            </a>
          </div>

          <div class="hero-invite-notice">
            अर्ली एक्सेस केवल इनवाइट कोड द्वारा उपलब्ध है · {siteConfig.inviteNoticeHi}
          </div>

          <div class="hero-chips-row">
            <span>10+ प्रकार</span>
            <span class="sep">·</span>
            <span>आपका Google Drive</span>
            <span class="sep">·</span>
            <span>10d / 2d / 0d अलर्ट</span>
          </div>
        </div>
      </div>

      <!-- Telegram Chat Mockup & Video Placeholder (Right Column on Desktop) -->
      <div class="hero-visual reveal">
        <TelegramMockup />
        <div class="hero-video-slot">
          <VideoPlaceholder />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ 2. HOW IT WORKS (Surface #F5F5F7) ═══════════════════ -->
  <section class="section section-surface" id="how-it-works">
    <div class="container reveal">
      <div class="section-header">
        <span class="section-eyebrow">सरल और घर्षण-रहित</span>
        <h2>SQUARES Vault कैसे काम करता है</h2>
        <p>कोई अलग ऐप डाउनलोड करने की ज़रूरत नहीं। कोई नया पासवर्ड नहीं। सब कुछ आपके मौजूदा टेलीग्राम में काम करता है।</p>
      </div>

      <div class="steps-cards-grid">
        <div class="apple-step-card">
          <div class="apple-step-num">01</div>
          <h3 class="apple-step-title">15 सेकंड में कनेक्ट करें</h3>
          <p class="apple-step-text">
            टेलीग्राम में <code>/start</code> भेजें। Google के आधिकारिक डिवाइस फ़्लो से अपना Google Drive कनेक्ट करें। SQUARES Vault को केवल अपने द्वारा बनाई गई फ़ाइलों को प्रबंधित करने की अनुमति मिलती है।
          </p>
        </div>

        <div class="apple-step-card">
          <div class="apple-step-num">02</div>
          <h3 class="apple-step-title">फ़ोटो या PDF भेजें</h3>
          <p class="apple-step-text">
            ईमेल से बीमा पॉलिसी की PDF फॉरवर्ड करें या गाड़ी के कागज़ात, उपकरण इनवॉइस या रसीद की तस्वीर खींचकर भेजें। मल्टी-पेज दस्तावेज़ भी एक साथ भेजे जा सकते हैं।
          </p>
        </div>

        <div class="apple-step-card">
          <div class="apple-step-num">03</div>
          <h3 class="apple-step-title">इन-मेमोरी AI रीडिंग</h3>
          <p class="apple-step-text">
            Gemini AI श्रेणी, शीर्षक, एक्सपायरी तारीख़, प्रोवाइडर और विवरण पढ़ लेता है। चैट में बने ड्राफ़्ट रिकॉर्ड की समीक्षा करें और एक टैप में पुष्टि करें।
          </p>
        </div>

        <div class="apple-step-card">
          <div class="apple-step-num">04</div>
          <h3 class="apple-step-title">स्वचालित रिन्यूअल अलर्ट</h3>
          <p class="apple-step-text">
            एक्सपायरी से 10 दिन पहले, 2 दिन पहले और उसी दिन सुबह 9:00 बजे रिमाइंडर पाएं। 'स्नूज़' करें, 'रिन्यू' करें, या जब भी ज़रूरत हो सामान्य भाषा में सवाल पूछें।
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ 3. FEATURES BENTO GRID (White Surface) ═══════════════════ -->
  <section class="section" id="features">
    <div class="container-bento reveal">
      <div class="section-header">
        <span class="section-eyebrow">घरेलू शांति के लिए तैयार</span>
        <h2>आपकी ज़िंदगी को व्यवस्थित रखने वाली सुविधाएँ</h2>
        <p>एक सुव्यवस्थित डिजिटल फ़ाइलिंग कैबिनेट जो आपके सभी कागज़ात की समय-सीमा का ध्यान रखती है।</p>
      </div>

      <div class="bento-grid">
        <!-- Tile 1: 2x2 Hero Tile -->
        <div class="bento-tile bento-tile-hero">
          <div>
            <div class="bento-icon"><LucideIcon name="car" size={32} /></div>
            <h3 class="bento-title">गाड़ी मल्टी-हॉप लिंकिंग</h3>
            <p class="bento-desc">
              अपनी गाड़ी का रजिस्ट्रेशन एक बार जोड़ें। इसके बाद उस गाड़ी का कोई भी बीमा, इंस्पेक्शन सर्टिफ़िकेट या सर्विस रसीद अपने-आप उस नंबर प्लेट से जुड़ जाती है।
            </p>
          </div>
          <div style="margin-top: 24px; padding: 14px 18px; background-color: #ffffff; border-radius: 14px; border: 1px solid var(--hairline); display: flex; align-items: center; justify-content: space-between;">
            <div style="font-size: 13px; font-weight: 500; color: var(--text);">संबद्ध नंबर प्लेट: UP15EB3XX3</div>
            <span class="badge-status active">3 जुड़े दस्तावेज़</span>
          </div>
        </div>

        <!-- Tile 2: 2x1 Wide Tile -->
        <div class="bento-tile bento-tile-wide">
          <div>
            <div class="bento-icon"><LucideIcon name="shield" size={28} /></div>
            <h3 class="bento-title">आपके अपने Google Drive में स्टोरेज</h3>
            <p class="bento-desc">
              हम सर्वर पर शून्य फ़ाइल कस्टडी के सिद्धांत पर काम करते हैं। मूल फ़ाइलें सीधे आपके निजी Google Drive में सहेजी जाती हैं और उनका पूर्ण स्वामित्व हमेशा आपके पास रहता है।
            </p>
          </div>
        </div>

        <!-- Tile 3: 2x1 Wide Tile -->
        <div class="bento-tile bento-tile-wide">
          <div>
            <div class="bento-icon"><LucideIcon name="file-text" size={28} /></div>
            <h3 class="bento-title">"वॉल्ट से पूछें" स्वाभाविक भाषा Q&amp;A</h3>
            <p class="bento-desc">
              अपनी सामान्य भाषा में पूछें: <em>"अगले महीने क्या एक्सपायर हो रहा है?"</em> या <em>"गाड़ी का बीमा कब रिन्यू होना है?"</em>। बॉट तुरंत सटीक जवाब और फ़ाइल लिंक प्रस्तुत करता है।
            </p>
          </div>
        </div>

        <!-- Tile 4: 1x1 Single Tile -->
        <div class="bento-tile bento-tile-single">
          <div>
            <div class="bento-icon"><LucideIcon name="home" size={26} /></div>
            <h3 class="bento-title" style="font-size: 20px;">परिवार के साथ शेयरिंग</h3>
            <p class="bento-desc" style="font-size: 14px;">
              अस्पताल या सर्विस सेंटर पर खड़े होकर कागज़ात ढूँढने की ज़रूरत नहीं। परिवार को सुरक्षित व्यू एक्सेस दें।
            </p>
          </div>
        </div>

        <!-- Tile 5: 1x1 Single Tile -->
        <div class="bento-tile bento-tile-single">
          <div>
            <div class="bento-icon"><LucideIcon name="calendar" size={26} /></div>
            <h3 class="bento-title" style="font-size: 20px;">कैलेंडर एक्सपोर्ट व सर्च</h3>
            <p class="bento-desc" style="font-size: 14px;">
              सभी अंतिम तारीख़ों को <code>.ics</code> फ़ाइल के रूप में Google Calendar या Apple Calendar में एक्सपोर्ट करें।
            </p>
          </div>
        </div>

        <!-- Tile 6: 2x1 Double Tile -->
        <div class="bento-tile bento-tile-double">
          <div>
            <div class="bento-icon"><LucideIcon name="receipt" size={26} /></div>
            <h3 class="bento-title" style="font-size: 20px;">मैन्युअल एंट्री व रिन्यूअल विज़ार्ड</h3>
            <p class="bento-desc" style="font-size: 14px;">
              बिना AI के दस्तावेज़ जोड़ना चाहते हैं? चरण-दर-चरण विज़ार्ड और स्मार्ट तारीख़ शॉर्टकट (+6 महीने, +1 साल, +2 साल) का उपयोग करें। वार्षिक रिन्यूअल सेकंडों में दर्ज करें।
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ 4. PRIVACY BY ARCHITECTURE (Dramatic Black) ═══════════════════ -->
  <section class="section section-dark reveal" id="privacy">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow" style="color: var(--accent);">ईमानदार और स्पष्ट गोपनीयता</span>
        <h2 style="color: #f5f5f7;">सुरक्षा नीति, नारों में नहीं बल्कि बनावट में</h2>
        <p style="color: #86868b;">आपकी फ़ाइलों, टोकन और डेटा के उपयोग का पारदर्शी विवरण।</p>
      </div>

      <div class="privacy-grid">
        <div class="privacy-tile">
          <strong>1. सर्वर पर शून्य फ़ाइल स्टोरेज</strong>
          <p>
            आपकी मूल फ़ाइलें सीधे आपके निजी Google Drive में अपलोड होती हैं। हम अपने सर्वर पर आपके दस्तावेज़ों की कोई स्थायी प्रति नहीं रखते।
          </p>
        </div>

        <div class="privacy-tile">
          <strong>2. सीमित <code>drive.file</code> अनुमति</strong>
          <p>
            हम केवल उन फ़ाइलों की अनुमति माँगते हैं जो SQUARES Vault द्वारा बनाई गई हैं। हम आपके Drive की किसी अन्य पहले से मौजूद फ़ाइल को न देख सकते हैं, न बदल सकते हैं।
          </p>
        </div>

        <div class="privacy-tile">
          <strong>3. Google Gemini API प्रोसेसिंग</strong>
          <p>
            दस्तावेज़ पढ़ने और तारीख़ निकालने का काम इन-ट्रांज़िट Google Gemini API द्वारा होता है। डेटा उपयोग के बारे में अधिक जानकारी के लिए <a href="https://ai.google.dev/terms" target="_blank" rel="noopener noreferrer">Google Gemini API Terms</a> देखें।
          </p>
        </div>

        <div class="privacy-tile">
          <strong>4. <code>/deletemydata</code> से तुरंत निष्कासन</strong>
          <p>
            टेलीग्राम में <code>/deletemydata</code> टाइप करते ही हमारा डेटाबेस आपका सारा डेटा हमेशा के लिए मिटा देता है और OAuth अनुमति रद्द हो जाती है। Drive की फ़ाइलें आपकी ही रहती हैं।
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ 5. COMPARISON TABLE (White Surface) ═══════════════════ -->
  <section class="section reveal" id="comparison">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">निष्पक्ष तुलना</span>
        <h2>क्लाउड फ़ोल्डर या सरकारी पोर्टल से अलग क्यों?</h2>
        <p>अलग-अलग टूल अलग-अलग उद्देश्यों के लिए होते हैं। यहाँ एक निष्पक्ष और तथ्यपरक तुलना है।</p>
      </div>

      <ComparisonTable />

      <div style="margin-top: 32px; font-size: 14px; color: var(--muted); text-align: center;">
        विस्तृत तुलना मार्गदर्शिका पढ़ें: <a href={getAssetUrl('/vs/digilocker/')} class="link-apple"><span>SQUARES Vault बनाम सरकारी पोर्टल</span><span class="chevron">›</span></a> · <a href={getAssetUrl('/vs/google-drive/')} class="link-apple"><span>SQUARES Vault बनाम केवल Google Drive</span><span class="chevron">›</span></a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ 6. DOCUMENT TYPES DIRECTORY (Surface #F5F5F7) ═══════════════════ -->
  <section class="section section-surface reveal" id="documents">
    <div class="container docs-horizontal-container">
      <div class="section-header">
        <span class="section-eyebrow">समर्थित दस्तावेज़</span>
        <h2>आधुनिक परिवारों के लिए 10 आवश्यक दस्तावेज़ प्रकार</h2>
        <p>विस्तृत गाइड, रिन्यूअल नियम और महत्वपूर्ण तारीख़ों की जानकारी देखें।</p>
      </div>

      <div class="docs-grid-apple">
        {documents.map((doc) => (
          <DocumentCard
            title={doc.name}
            category={doc.category}
            iconName={doc.icon}
            slug={doc.slug}
            summary={doc.summary}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════ 7. AUDIENCE SOLUTIONS (White Surface) ═══════════════════ -->
  <section class="section reveal" id="audiences">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">विशेष समाधान</span>
        <h2>SQUARES Vault किसके लिए उपयोगी है?</h2>
        <p>रोज़मर्रा की वास्तविक ज़रूरतों को ध्यान में रखकर तैयार किए गए समाधान।</p>
      </div>

      <div class="audiences-grid-apple">
        {audiences.map((aud) => (
          <div class="audience-card-apple">
            <div>
              <h3>
                <a href={getAssetUrl(`/for/${aud.slug}/`)}>
                  {aud.title}
                </a>
              </h3>
              <p>
                {aud.subtitle}
              </p>
            </div>
            <a href={getAssetUrl(`/for/${aud.slug}/`)} class="link-apple">
              <span>समाधान गाइड पढ़ें</span>
              <span class="chevron">›</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════ 8. TESTIMONIALS (CONDITIONAL) ═══════════════════ -->
  <Testimonials />

  <!-- ═══════════════════ 9. FAQS (White Surface) ═══════════════════ -->
  <section class="section reveal" id="faq">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">अक्सर पूछे जाने वाले सवाल</span>
        <h2>सच्चे और स्पष्ट जवाब</h2>
        <p>गोपनीयता, Google Gemini API और सुरक्षा से जुड़े मुख्य सवालों के उत्तर।</p>
      </div>

      <FaqAccordion items={hindiFaqs} />
    </div>
  </section>

  <!-- ═══════════════════ 10. FINAL CALL TO ACTION (Dramatic Black) ═══════════════════ -->
  <section class="section section-dark final-cta-apple reveal">
    <div class="container text-container">
      <h2>अपने सभी कागज़ात आज ही व्यवस्थित करें।</h2>
      <p>
        टेलीग्राम में अपने दस्तावेज़ व्यवस्थित करने के लिए मुफ़्त इनवाइट कोड का अनुरोध करें।
      </p>

      <div style="display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; margin-bottom: 24px;">
        <a href={siteConfig.inviteEmailUrl} class="btn-apple-primary" style="padding: 14px 32px; font-size: 18px;">
          <span>मुफ़्त इनवाइट कोड मांगें</span>
        </a>
      </div>

      <div style="font-size: 14px; color: #86868b; line-height: 1.6;">
        {siteConfig.inviteNoticeHi} · {siteConfig.pricingNotice} · आपके अपने Google Drive में सुरक्षित स्टोरेज
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig, getAssetUrl } from '../config';
import LucideIcon from '../components/icons/LucideIcon.astro';

const title = 'Page Not Found | SQUARES Vault';
const description = 'The document or page you requested could not be located.';
---

<BaseLayout title={title} description={description} canonicalPath="/404.html">
  <div class="container" style="padding: 100px 0 140px; text-align: center; max-width: 600px;">
    <div style="display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 64px; border-radius: var(--radius-card); background-color: var(--surface); margin-bottom: 24px; color: var(--muted);">
      <LucideIcon name="file-question" size={32} />
    </div>

    <div style="font-size: 14px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--danger); margin-bottom: 12px;">
      404 · Unfiled Record
    </div>

    <h1 style="font-size: clamp(32px, 5vw, 48px); margin-bottom: 16px;">This page could not be found.</h1>

    <p style="font-size: 17px; color: var(--muted); line-height: 1.5; margin-bottom: 36px;">
      The page or document reference you were looking for does not exist, may have been relocated, or is temporarily unavailable.
    </p>

    <div style="display: flex; justify-content: center; gap: 14px; flex-wrap: wrap;">
      <a href={getAssetUrl('/')} class="btn-apple-primary">
        <span>Return to Homepage</span>
      </a>
      <a href={siteConfig.inviteEmailUrl} class="btn-apple-secondary">
        <span>Request Invite Code</span>
      </a>
    </div>

    <div style="margin-top: 56px; padding-top: 32px; border-top: 1px solid var(--hairline); font-size: 14px; color: var(--muted);">
      Looking for something specific? Browse our <a href={getAssetUrl('/guides/')} class="link-apple"><span>Guides</span> <span class="chevron">›</span></a> or <a href={getAssetUrl('/vs/digilocker/')} class="link-apple"><span>Comparisons</span> <span class="chevron">›</span></a>.
    </div>
  </div>
</BaseLayout>

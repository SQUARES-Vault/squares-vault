---
import BaseLayout from '../layouts/BaseLayout.astro';
import TelegramMockup from '../components/TelegramMockup.astro';
import VideoPlaceholder from '../components/VideoPlaceholder.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import Testimonials from '../components/Testimonials.astro';
import DocumentCard from '../components/DocumentCard.astro';
import LucideIcon from '../components/icons/LucideIcon.astro';
import documents from '../data/documents.json';
import audiences from '../data/audiences.json';
import { siteConfig, getAssetUrl } from '../config';

const homeFaqs = [
  {
    q: 'How does SQUARES Vault access my Google Drive?',
    a: 'During setup, you authorize SQUARES Vault via Google’s official Device Flow. We request only two narrowly-scoped permissions: <code>drive.file</code> (which permits viewing and managing only the files created by SQUARES Vault) and <code>drive.appdata</code> (for configuration sync). We cannot view, open, or modify any other files or folders in your personal Google Drive.',
  },
  {
    q: 'How is my document data processed by AI?',
    a: 'Documents are processed using Google’s Gemini API for optical character recognition and key-date extraction. Processing takes place in transit/volatile memory. Please refer to <a href="https://ai.google.dev/terms" target="_blank" rel="noopener noreferrer">Google’s Gemini API Terms of Service</a> for details on Google’s API data handling terms.',
  },
  {
    q: 'Is SQUARES Vault free to use?',
    a: siteConfig.pricingNotice,
  },
  {
    q: 'What happens if I decide to delete my data?',
    a: 'You can type <code>/deletemydata</code> directly in the Telegram bot at any time. This permanently deletes your user profile and indexed metadata from our databases, revokes the Google OAuth access token, and cancels all pending reminder schedules. Your original files stored inside your personal Google Drive remain unaffected and completely under your control.',
  },
  {
    q: 'Can other people see my documents?',
    a: 'No. Your documents are filed into your private Google Drive and associated with your unique Telegram user ID. Only you—and any family members you explicitly authorize through the Family Access Sharing settings—can search or retrieve your records.',
  },
];
---

<BaseLayout
  title="SQUARES Vault — Private Life-Admin & Document Expiry Assistant"
  description="Forward your vehicle RC, insurance, warranties and bills in Telegram. Gemini AI logs the dates, saves files to your personal Google Drive, and alerts you before renewal."
  canonicalPath="/"
  hreflangHi="/hi/"
>
  <!-- ═══════════════════ 1. HERO (Expansive 2-Column Split) ═══════════════════ -->
  <section class="section hero-apple">
    <div class="container hero-grid">
      <div class="hero-content">
        <div class="hero-eyebrow">Personal Life-Admin · Telegram Assistant</div>
        <h1 class="hero-title">
          <span class="hero-line">Your vital documents, organised.</span>
          <span class="hero-line">Expiries tracked before they cost you.</span>
        </h1>

        <p class="hero-subhead">
          Forward your vehicle titles & registrations, auto and medical insurance, appliance warranties, rental leases, and utility bills in Telegram.
          Gemini AI extracts key renewal dates, saves the original files directly into <strong>your personal Google Drive</strong>, and alerts you before anything expires.
        </p>

        <div class="hero-cta-cluster">
          <div class="hero-buttons-row">
            <a href={siteConfig.inviteEmailUrl} class="btn-apple-primary">
              <span>Request Free Invite Code</span>
            </a>
            <a href={siteConfig.botUrl} target="_blank" rel="noopener noreferrer" class="link-apple">
              <span>Open in Telegram</span>
              <span class="chevron">›</span>
            </a>
            <a href="#how-it-works" class="link-apple">
              <span>See How It Works</span>
              <span class="chevron">›</span>
            </a>
          </div>

          <div class="hero-invite-notice">
            Early access is currently invite-only · {siteConfig.inviteNotice}
          </div>

          <div class="hero-chips-row">
            <span>10+ Types</span>
            <span class="sep">·</span>
            <span>Your Google Drive</span>
            <span class="sep">·</span>
            <span>10d / 2d / 0d Alerts</span>
          </div>
        </div>
      </div>

      <!-- Telegram Chat Mockup & Video Placeholder (Right Column on Desktop) -->
      <div class="hero-visual reveal">
        <TelegramMockup />
        <div class="hero-video-slot">
          <VideoPlaceholder />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ 2. HOW IT WORKS (Surface #F5F5F7) ═══════════════════ -->
  <section class="section section-surface" id="how-it-works">
    <div class="container reveal">
      <div class="section-header">
        <span class="section-eyebrow">Simple &amp; Frictionless</span>
        <h2>How SQUARES Vault Works</h2>
        <p>No separate app download. No passwords to remember. Everything operates inside your existing Telegram app.</p>
      </div>

      <div class="steps-cards-grid">
        <div class="apple-step-card">
          <div class="apple-step-num">01</div>
          <h3 class="apple-step-title">Connect in 15 seconds</h3>
          <p class="apple-step-text">
            Send <code>/start</code> in Telegram. Connect your personal Google Drive via Google's secure Device Flow. SQUARES Vault only receives permission to manage files it creates.
          </p>
        </div>

        <div class="apple-step-card">
          <div class="apple-step-num">02</div>
          <h3 class="apple-step-title">Snap or forward any paper</h3>
          <p class="apple-step-text">
            Forward an insurance PDF from your email, or photograph a vehicle registration, appliance invoice, or inspection slip. Multi-page documents can be sent in a single photo batch.
          </p>
        </div>

        <div class="apple-step-card">
          <div class="apple-step-num">03</div>
          <h3 class="apple-step-title">In-memory AI reading</h3>
          <p class="apple-step-text">
            Gemini AI extracts the category, title, expiry date, provider, and vehicle number. Review the drafted record in chat and confirm with one tap.
          </p>
        </div>

        <div class="apple-step-card">
          <div class="apple-step-num">04</div>
          <h3 class="apple-step-title">Automated renewal alerts</h3>
          <p class="apple-step-text">
            Receive reminders at 10 days, 2 days, and same-day at 09:00 AM local time. Tap 'Snooze', 'Renew', or ask natural language questions whenever you need answers.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ 3. FEATURES BENTO GRID (White Surface) ═══════════════════ -->
  <section class="section" id="features">
    <div class="container-bento reveal">
      <div class="section-header">
        <span class="section-eyebrow">Built for Real Life</span>
        <h2>Features engineered for household peace of mind</h2>
        <p>A structured filing cabinet that actively keeps track of your household compliance.</p>
      </div>

      <!-- Apple Bento Grid: 6 tiles in 4-column layout -->
      <div class="bento-grid">
        <!-- Tile 1: 2x2 Hero Tile -->
        <div class="bento-tile bento-tile-hero">
          <div>
            <div class="bento-icon"><LucideIcon name="car" size={32} /></div>
            <h3 class="bento-title">Vehicle Multi-Hop Linking</h3>
            <p class="bento-desc">
              Save your car's registration once. SQUARES Vault automatically groups your insurance policies, inspection slips, service invoices, and traffic citations under your vehicle registration plate. Ask about your <em>"Venue"</em> and every related document surfaces together.
            </p>
          </div>
          <div style="margin-top: 24px; padding: 14px 18px; background-color: #ffffff; border-radius: 14px; border: 1px solid var(--hairline); display: flex; align-items: center; justify-content: space-between;">
            <div style="font-size: 13px; font-weight: 500; color: var(--text);">Linked Plate: UP15EB3XX3</div>
            <span class="badge-status active">3 Connected Docs</span>
          </div>
        </div>

        <!-- Tile 2: 2x1 Wide Tile -->
        <div class="bento-tile bento-tile-wide">
          <div>
            <div class="bento-icon"><LucideIcon name="shield" size={28} /></div>
            <h3 class="bento-title">Your Own Google Drive Storage</h3>
            <p class="bento-desc">
              We operate with zero file custody. Uploaded documents are saved directly into your personal Google Drive folder. You retain 100% legal ownership of your original files, completely independent of our service.
            </p>
          </div>
        </div>

        <!-- Tile 3: 2x1 Wide Tile -->
        <div class="bento-tile bento-tile-wide">
          <div>
            <div class="bento-icon"><LucideIcon name="file-text" size={28} /></div>
            <h3 class="bento-title">"Ask Your Vault" Natural Language Q&amp;A</h3>
            <p class="bento-desc">
              Ask questions in plain conversational language: <em>"What is due between Jan and June?"</em> or <em>"How much did I spend on maintenance?"</em>. The bot parses your indexed records and returns concise answers with clickable attachment links.
            </p>
          </div>
        </div>

        <!-- Tile 4: 1x1 Single Tile -->
        <div class="bento-tile bento-tile-single">
          <div>
            <div class="bento-icon"><LucideIcon name="home" size={26} /></div>
            <h3 class="bento-title" style="font-size: 20px;">Family Access Sharing</h3>
            <p class="bento-desc" style="font-size: 14px;">
              Grant family members read access to specific categories without duplicating files during emergencies.
            </p>
          </div>
        </div>

        <!-- Tile 5: 1x1 Single Tile -->
        <div class="bento-tile bento-tile-single">
          <div>
            <div class="bento-icon"><LucideIcon name="calendar" size={26} /></div>
            <h3 class="bento-title" style="font-size: 20px;">Calendar Export &amp; Search</h3>
            <p class="bento-desc" style="font-size: 14px;">
              Export all upcoming deadlines as a standard <code>.ics</code> file into Google Calendar or Apple Calendar.
            </p>
          </div>
        </div>

        <!-- Tile 6: 2x1 Double Tile -->
        <div class="bento-tile bento-tile-double">
          <div>
            <div class="bento-icon"><LucideIcon name="receipt" size={26} /></div>
            <h3 class="bento-title" style="font-size: 20px;">Manual Entry &amp; Renewal Wizard</h3>
            <p class="bento-desc" style="font-size: 14px;">
              Prefer manual entry? Add any document without AI using our step-by-step wizard, equipped with smart date shortcuts (+6 Months, +1 Year, +2 Years). Record renewals in seconds.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ 4. PRIVACY BY ARCHITECTURE (Dramatic Black) ═══════════════════ -->
  <section class="section section-dark reveal" id="privacy">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow" style="color: var(--accent);">Honest &amp; Plain Language</span>
        <h2 style="color: #f5f5f7;">Privacy by Architecture, Not Slogans</h2>
        <p style="color: #86868b;">A transparent breakdown of how your files, tokens, and data are treated.</p>
      </div>

      <div class="privacy-grid">
        <div class="privacy-tile">
          <strong>1. Zero Server File Custody</strong>
          <p>
            Your original files are uploaded directly to your own Google Drive. We do not store permanent copies of your documents on our servers.
          </p>
        </div>

        <div class="privacy-tile">
          <strong>2. Narrow <code>drive.file</code> Scope</strong>
          <p>
            We only request access to files created by SQUARES Vault itself. We cannot view, open, or edit any pre-existing files in your Google Drive.
          </p>
        </div>

        <div class="privacy-tile">
          <strong>3. Google Gemini API Processing</strong>
          <p>
            Document OCR and date extraction are handled via Google's Gemini API in transit. For details on Google's API data practices, review <a href="https://ai.google.dev/terms" target="_blank" rel="noopener noreferrer">Google's Gemini API terms</a>.
          </p>
        </div>

        <div class="privacy-tile">
          <strong>4. Simple Deletion via <code>/deletemydata</code></strong>
          <p>
            Typing <code>/deletemydata</code> permanently deletes all your metadata from our database, revokes OAuth access, and cancels active reminders. Your Drive files remain yours.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ 5. COMPARISON TABLE (White Surface) ═══════════════════ -->
  <section class="section reveal" id="comparison">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Factual Comparison</span>
        <h2>Why not a cloud folder or government portal alone?</h2>
        <p>Different tools serve different purposes. Here is a fair and factual breakdown.</p>
      </div>

      <ComparisonTable />

      <div style="margin-top: 32px; font-size: 14px; color: var(--muted); text-align: center;">
        Read our in-depth guides: <a href={getAssetUrl('/vs/digilocker/')} class="link-apple"><span>SQUARES Vault vs Government Portals</span><span class="chevron">›</span></a> · <a href={getAssetUrl('/vs/google-drive/')} class="link-apple"><span>SQUARES Vault vs Drive Alone</span><span class="chevron">›</span></a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ 6. DOCUMENT TYPES DIRECTORY (Surface #F5F5F7) ═══════════════════ -->
  <section class="section section-surface reveal" id="documents">
    <div class="container docs-horizontal-container">
      <div class="section-header">
        <span class="section-eyebrow">Supported Documents</span>
        <h2>10 Essential Document Types Built for Modern Households</h2>
        <p>Explore detailed guides, renewal validity rules, and what dates matter for each document worldwide.</p>
      </div>

      <div class="docs-grid-apple">
        {documents.map((doc) => (
          <DocumentCard
            title={doc.name}
            category={doc.category}
            iconName={doc.icon}
            slug={doc.slug}
            summary={doc.summary}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════ 7. AUDIENCE SOLUTIONS (White Surface) ═══════════════════ -->
  <section class="section reveal" id="audiences">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Tailored Solutions</span>
        <h2>Who uses SQUARES Vault?</h2>
        <p>Specific life-admin setups designed around real household pain points.</p>
      </div>

      <div class="audiences-grid-apple">
        {audiences.map((aud) => (
          <div class="audience-card-apple">
            <div>
              <h3>
                <a href={getAssetUrl(`/for/${aud.slug}/`)}>
                  {aud.title}
                </a>
              </h3>
              <p>
                {aud.subtitle}
              </p>
            </div>
            <a href={getAssetUrl(`/for/${aud.slug}/`)} class="link-apple">
              <span>Read solution guide</span>
              <span class="chevron">›</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════ 8. TESTIMONIALS (CONDITIONAL) ═══════════════════ -->
  <Testimonials />

  <!-- ═══════════════════ 9. FAQ ACCORDION (White Surface) ═══════════════════ -->
  <section class="section reveal" id="faq">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Common Inquiries</span>
        <h2>Frequently Asked Questions</h2>
        <p>Direct answers about permissions, Google Gemini API handling, and security.</p>
      </div>

      <FaqAccordion items={homeFaqs} />
    </div>
  </section>

  <!-- ═══════════════════ 10. FINAL CALL TO ACTION (Dramatic Black) ═══════════════════ -->
  <section class="section section-dark final-cta-apple reveal">
    <div class="container text-container">
      <h2>Take control of your household life-admin.</h2>
      <p>
        Request your free invite code to start organizing your vital documents in Telegram.
      </p>

      <div style="display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; margin-bottom: 24px;">
        <a href={siteConfig.inviteEmailUrl} class="btn-apple-primary" style="padding: 14px 32px; font-size: 18px;">
          <span>Request Free Invite Code</span>
        </a>
      </div>

      <div style="font-size: 14px; color: #86868b; line-height: 1.6;">
        {siteConfig.inviteNotice} · {siteConfig.pricingNotice} · Zero server file custody
      </div>
    </div>
  </section>
</BaseLayout>

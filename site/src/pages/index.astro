---
import BaseLayout from '../layouts/BaseLayout.astro';
import TelegramMockup from '../components/TelegramMockup.astro';
import VideoPlaceholder from '../components/VideoPlaceholder.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import Testimonials from '../components/Testimonials.astro';
import DocumentCard from '../components/DocumentCard.astro';
import LucideIcon from '../components/icons/LucideIcon.astro';
import documents from '../data/documents.json';
import audiences from '../data/audiences.json';
import { siteConfig, getAssetUrl } from '../config';

const homeFaqs = [
  {
    q: 'How does SQUARES Vault access my Google Drive?',
    a: 'During setup, you authorize SQUARES Vault via Google’s official Device Flow. We request only two narrowly-scoped permissions: <code>drive.file</code> (which permits viewing and managing only the files created by SQUARES Vault) and <code>drive.appdata</code> (for configuration sync). We cannot view, open, or modify any other files or folders in your personal Google Drive.',
  },
  {
    q: 'How is my document data processed by AI?',
    a: 'Documents are processed using Google’s Gemini API for optical character recognition and key-date extraction. Processing takes place in transit/volatile memory. Please refer to <a href="https://ai.google.dev/terms" target="_blank" rel="noopener noreferrer">Google’s Gemini API Terms of Service</a> for details on Google’s API data handling terms.',
  },
  {
    q: 'Is SQUARES Vault free to use?',
    a: siteConfig.pricingNotice,
  },
  {
    q: 'What happens if I decide to delete my data?',
    a: 'You can type <code>/deletemydata</code> directly in the Telegram bot at any time. This permanently deletes your user profile and indexed metadata from our databases, revokes the Google OAuth access token, and cancels all pending reminder schedules. Your original files stored inside your personal Google Drive remain unaffected and completely under your control.',
  },
  {
    q: 'Can other people see my documents?',
    a: 'No. Your documents are filed into your private Google Drive and associated with your unique Telegram user ID. Only you—and any family members you explicitly authorize through the Family Access Sharing settings—can search or retrieve your records.',
  },
];

// Categorize documents for structured display
const vehicleDocs = documents.filter(d => ['vehicle-rc', 'puc-certificate', 'car-insurance', 'traffic-challans'].includes(d.slug));
const homeDocs = documents.filter(d => ['appliance-invoices', 'extended-warranty', 'utility-bills'].includes(d.slug));
const identityDocs = documents.filter(d => ['health-insurance', 'passport', 'rental-agreements'].includes(d.slug));
---

<BaseLayout
  title="SQUARES Vault — Private Life-Admin & Document Expiry Assistant"
  description="Forward your vehicle RC, insurance, warranties and bills in Telegram. Gemini AI logs the dates, saves files to your personal Google Drive, and alerts you before renewal."
  canonicalPath="/"
  hreflangHi="/hi/"
>
  <!-- ═══════════════════ 1. HERO (2-Column Showcase) ═══════════════════ -->
  <section class="section hero-custom">
    <div class="container">
      <div class="hero-grid">
        <!-- Left: Content & Action Cluster -->
        <div class="reveal">
          <div class="hero-badge-tag">
            <span class="hero-pulse-dot"></span>
            <span>Zero-Custodian Telegram Assistant</span>
          </div>

          <h1 class="hero-title">
            Your vital documents, neatly indexed.<br />
            Expiry deadlines handled automatically.
          </h1>

          <p class="hero-subhead">
            Forward your vehicle titles &amp; registrations, auto and medical insurance, appliance warranties, rental leases, and utility bills in Telegram.
            Gemini AI extracts renewal dates, saves original files directly into <strong>your personal Google Drive</strong>, and alerts you before anything expires.
          </p>

          <div class="hero-cta-cluster">
            <div class="hero-buttons-row">
              <a href={siteConfig.inviteEmailUrl} class="btn-primary">
                <span>Request Free Invite Code</span>
              </a>
              <a href="#how-it-works" class="btn-secondary">
                <span>See How It Works ↓</span>
              </a>
            </div>

            <div class="hero-invite-notice">
              <span>🔒 Early access is invite-only · {siteConfig.inviteNotice}</span>
            </div>
          </div>

          <div class="hero-trust-bar">
            <div class="trust-chip">
              <LucideIcon name="shield" size={15} />
              <span>Zero File Custody</span>
            </div>
            <div class="trust-chip">
              <LucideIcon name="file-text" size={15} />
              <span>Direct to Your Drive</span>
            </div>
            <div class="trust-chip">
              <LucideIcon name="bell" size={15} />
              <span>10d / 2d / 0d Alerts</span>
            </div>
          </div>
        </div>

        <!-- Right: Interactive Telegram Live Dossier Mockup -->
        <div class="hero-showcase-column reveal">
          <TelegramMockup />
          
          <div class="hero-showcase-footnote">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span class="badge-status active">Live Dossier</span>
              <span>Vehicle Multi-Hop: Hyundai VENUE</span>
            </div>
            <span class="badge-plate">UP15EB3XX3</span>
          </div>

          <div style="margin-top: 16px; width: 100%; max-width: 440px;">
            <VideoPlaceholder />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ 2. HOW IT WORKS (Connected Pipeline Ribbon) ═══════════════════ -->
  <section class="section section-surface" id="how-it-works">
    <div class="container reveal">
      <div class="section-header">
        <span class="section-eyebrow">Zero Friction Workflow</span>
        <h2>How SQUARES Vault Works</h2>
        <p>No separate app download. No passwords to remember. Everything operates inside your existing Telegram app.</p>
      </div>

      <div class="workflow-pipeline">
        <!-- Step 1 -->
        <div class="workflow-step-card">
          <div class="workflow-step-top">
            <span class="workflow-step-num">01</span>
            <span class="workflow-step-chip">Google Device Flow</span>
          </div>
          <h3 class="workflow-step-title">Connect in 15 seconds</h3>
          <p class="workflow-step-text">
            Send <code>/start</code> in Telegram. Authenticate your Google Drive via Google's secure Device Flow. SQUARES Vault only receives permission to manage files it creates (<code>drive.file</code>).
          </p>
        </div>

        <!-- Step 2 -->
        <div class="workflow-step-card">
          <div class="workflow-step-top">
            <span class="workflow-step-num">02</span>
            <span class="workflow-step-chip">PDF &amp; Photo Batches</span>
          </div>
          <h3 class="workflow-step-title">Forward or snap paper</h3>
          <p class="workflow-step-text">
            Forward an insurance PDF from your email, or photograph a vehicle registration, appliance invoice, or inspection slip. Multi-page documents can be sent in a single photo batch.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="workflow-step-card">
          <div class="workflow-step-top">
            <span class="workflow-step-num">03</span>
            <span class="workflow-step-chip">Gemini AI OCR</span>
          </div>
          <h3 class="workflow-step-title">In-memory AI extraction</h3>
          <p class="workflow-step-text">
            Gemini AI extracts category, title, expiry date, provider, and vehicle number. Full policy &amp; ID numbers are masked (<code>••••3113</code>). Review the drafted record and confirm in 1 tap.
          </p>
        </div>

        <!-- Step 4 -->
        <div class="workflow-step-card">
          <div class="workflow-step-top">
            <span class="workflow-step-num">04</span>
            <span class="workflow-step-chip">09:00 AM Alerts</span>
          </div>
          <h3 class="workflow-step-title">Automated renewal shield</h3>
          <p class="workflow-step-text">
            Receive reminders at 10 days, 2 days, and same-day at 09:00 AM local time. Tap 'Snooze', 'Renew', or ask natural language questions whenever you need answers.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ 3. SYSTEM CAPABILITIES SHOWCASE ═══════════════════ -->
  <section class="section" id="features">
    <div class="container reveal">
      <div class="section-header">
        <span class="section-eyebrow">Engineered Capabilities</span>
        <h2>Features built for real household peace of mind</h2>
        <p>A structured filing assistant that actively keeps track of your household compliance without holding your files.</p>
      </div>

      <!-- Part 1: Dual Feature Spotlight Banner -->
      <div class="spotlight-banner">
        <!-- Spotlight 1: Vehicle Multi-Hop -->
        <div class="spotlight-card">
          <div class="spotlight-header">
            <div class="spotlight-icon-box">
              <LucideIcon name="car" size={24} />
            </div>
            <h3 class="spotlight-title">Vehicle Multi-Hop Linking</h3>
            <p class="spotlight-desc">
              Save your car's registration once. SQUARES Vault automatically groups your insurance policies, inspection certificates, service receipts, and citations under your vehicle registration plate. Ask about your <em>"Venue"</em> and every related document surfaces together.
            </p>
          </div>

          <div class="spotlight-preview-box">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
              <span style="font-size: 13px; font-weight: 600; color: var(--text);">Connected Dossier: Hyundai VENUE</span>
              <span class="badge-plate">UP15EB3XX3</span>
            </div>
            <div style="display: flex; flex-direction: column; gap: 6px;">
              <div style="display: flex; justify-content: space-between; font-size: 12.5px; padding: 4px 0; border-bottom: 1px solid var(--hairline-subtle);">
                <span>1. Vehicle Registration &amp; Title</span>
                <span class="badge-status active">Active</span>
              </div>
              <div style="display: flex; justify-content: space-between; font-size: 12.5px; padding: 4px 0; border-bottom: 1px solid var(--hairline-subtle);">
                <span>2. Auto Insurance Policy</span>
                <span class="badge-status expiring">17 Days</span>
              </div>
              <div style="display: flex; justify-content: space-between; font-size: 12.5px; padding: 4px 0;">
                <span>3. Safety &amp; Emissions (PUC)</span>
                <span class="badge-status active">Valid</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Spotlight 2: Ask Your Vault -->
        <div class="spotlight-card">
          <div class="spotlight-header">
            <div class="spotlight-icon-box">
              <LucideIcon name="file-text" size={24} />
            </div>
            <h3 class="spotlight-title">"Ask Your Vault" Conversational Search</h3>
            <p class="spotlight-desc">
              Query your indexed records in plain language: <em>"What is due between Jan and June?"</em> or <em>"When does my car warranty end?"</em>. The bot parses your encrypted index and returns immediate answers with deep-links to the original file in your Drive.
            </p>
          </div>

          <div class="spotlight-preview-box">
            <div style="font-size: 12.5px; color: var(--muted); margin-bottom: 6px;">Sample Conversation</div>
            <div style="background-color: var(--surface); padding: 8px 12px; border-radius: 6px; font-size: 13px; font-weight: 500; color: var(--text); margin-bottom: 6px;">
              💬 "What deadlines are approaching in November?"
            </div>
            <div style="background-color: var(--surface); padding: 8px 12px; border-radius: 6px; font-size: 12.5px; color: var(--text); border-left: 3px solid var(--accent);">
              🤖 Found 2 records: 1) Venue Auto Insurance (Expires Nov 10), 2) Electricity Bill (Due Nov 15).
            </div>
          </div>
        </div>
      </div>

      <!-- Part 2: 4 Engineering Pillars -->
      <div class="pillars-grid">
        <div class="pillar-card">
          <div class="pillar-icon"><LucideIcon name="shield" size={24} /></div>
          <h3 class="pillar-title">Zero Server Custody</h3>
          <p class="pillar-text">
            Documents upload directly into your personal Google Drive (<code>drive.file</code>). You retain 100% ownership and control.
          </p>
        </div>

        <div class="pillar-card">
          <div class="pillar-icon"><LucideIcon name="bell" size={24} /></div>
          <h3 class="pillar-title">Multi-Stage Alerts</h3>
          <p class="pillar-text">
            Escalating reminders at 10 days, 2 days, and same-day at 09:00 AM local time. Includes 1-tap Snooze and renewal links.
          </p>
        </div>

        <div class="pillar-card">
          <div class="pillar-icon"><LucideIcon name="home" size={24} /></div>
          <h3 class="pillar-title">Family Access Sharing</h3>
          <p class="pillar-text">
            Grant family members read-only access to vital categories (like medical policies) without duplicating files during emergencies.
          </p>
        </div>

        <div class="pillar-card">
          <div class="pillar-icon"><LucideIcon name="receipt" size={24} /></div>
          <h3 class="pillar-title">Manual Entry Wizard</h3>
          <p class="pillar-text">
            Prefer manual entry? Add any document without AI using smart relative date shortcuts (+6 Months, +1 Year, +2 Years).
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ 4. ZERO-CUSTODIAN BLUEPRINT (Dark Contrast Section) ═══════════════════ -->
  <section class="section section-dark reveal" id="privacy">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow" style="background-color: rgba(41, 151, 255, 0.15); color: var(--accent);">Architectural Blueprint</span>
        <h2 style="color: #f5f5f7;">Privacy by Architecture, Not Slogans</h2>
        <p style="color: #8e8e93;">A transparent breakdown of how your files, tokens, and data are treated.</p>
      </div>

      <!-- Top Visual Data Flow Bar -->
      <div class="blueprint-pipeline-bar">
        <div class="blueprint-stage">
          <span>📱 Telegram Transit</span>
        </div>
        <div class="blueprint-arrow">──►</div>
        <div class="blueprint-stage">
          <span>🧠 In-Memory AI OCR (Gemini API)</span>
        </div>
        <div class="blueprint-arrow">──►</div>
        <div class="blueprint-stage">
          <span>📁 Your Private Google Drive</span>
        </div>
        <div class="blueprint-arrow">──►</div>
        <div class="blueprint-stage" style="color: var(--accent);">
          <span>0% Server File Retention</span>
        </div>
      </div>

      <div class="blueprint-grid">
        <div class="blueprint-card">
          <div class="blueprint-card-header">
            <strong>1. Zero Server File Custody</strong>
          </div>
          <p>
            Your original files are uploaded directly to your own Google Drive. We do not store permanent copies of your documents on our servers.
          </p>
        </div>

        <div class="blueprint-card">
          <div class="blueprint-card-header">
            <strong>2. Narrow <code>drive.file</code> Scope Isolation</strong>
          </div>
          <p>
            We only request access to files created by SQUARES Vault itself. We cannot view, open, or edit any pre-existing files or folders in your Google Drive.
          </p>
        </div>

        <div class="blueprint-card">
          <div class="blueprint-card-header">
            <strong>3. Google Gemini API Transparency</strong>
          </div>
          <p>
            Document OCR and date extraction are handled via Google's Gemini API in transit. For details on Google's API data practices, review <a href="https://ai.google.dev/terms" target="_blank" rel="noopener noreferrer">Google's Gemini API terms</a>.
          </p>
        </div>

        <div class="blueprint-card">
          <div class="blueprint-card-header">
            <strong>4. Instant Wipe via <code>/deletemydata</code></strong>
          </div>
          <p>
            Typing <code>/deletemydata</code> permanently deletes all your metadata from our database, revokes OAuth access, and cancels active reminders. Your Drive files remain yours.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ 5. CATEGORIZED DOCUMENT DIRECTORY ═══════════════════ -->
  <section class="section section-surface reveal" id="documents">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Document Registry</span>
        <h2>10 Essential Document Types Built for Modern Households</h2>
        <p>Organized into 3 essential household spheres with renewal cycles, guidelines, and what dates matter.</p>
      </div>

      <div class="doc-categories-wrapper">
        <!-- Category 1: Vehicle & Mobility -->
        <div class="doc-category-block">
          <div class="doc-category-header">
            <div class="doc-category-title">
              <LucideIcon name="car" size={20} />
              <span>Vehicle &amp; Transport</span>
            </div>
            <span class="doc-category-count">4 Documents</span>
          </div>
          <div class="doc-category-grid">
            {vehicleDocs.map((doc) => (
              <DocumentCard
                title={doc.name}
                category={doc.category}
                iconName={doc.icon}
                slug={doc.slug}
                summary={doc.summary}
              />
            ))}
          </div>
        </div>

        <!-- Category 2: Home & Assets -->
        <div class="doc-category-block">
          <div class="doc-category-header">
            <div class="doc-category-title">
              <LucideIcon name="home" size={20} />
              <span>Home &amp; Consumer Assets</span>
            </div>
            <span class="doc-category-count">3 Documents</span>
          </div>
          <div class="doc-category-grid">
            {homeDocs.map((doc) => (
              <DocumentCard
                title={doc.name}
                category={doc.category}
                iconName={doc.icon}
                slug={doc.slug}
                summary={doc.summary}
              />
            ))}
          </div>
        </div>

        <!-- Category 3: Health & Identity -->
        <div class="doc-category-block">
          <div class="doc-category-header">
            <div class="doc-category-title">
              <LucideIcon name="shield" size={20} />
              <span>Health &amp; Legal Identity</span>
            </div>
            <span class="doc-category-count">3 Documents</span>
          </div>
          <div class="doc-category-grid">
            {identityDocs.map((doc) => (
              <DocumentCard
                title={doc.name}
                category={doc.category}
                iconName={doc.icon}
                slug={doc.slug}
                summary={doc.summary}
              />
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ 6. COMPARISON MATRIX ═══════════════════ -->
  <section class="section reveal" id="comparison">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Factual Comparison</span>
        <h2>Why not a cloud folder or government portal alone?</h2>
        <p>Different tools serve different purposes. Here is a fair and factual breakdown.</p>
      </div>

      <ComparisonTable />

      <div style="margin-top: 28px; font-size: 14px; color: var(--muted); text-align: center;">
        Read our in-depth guides: <a href={getAssetUrl('/vs/digilocker/')} style="font-weight: 500;">SQUARES Vault vs Government Portals →</a> · <a href={getAssetUrl('/vs/google-drive/')} style="font-weight: 500;">SQUARES Vault vs Drive Alone →</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ 7. AUDIENCE SOLUTIONS ═══════════════════ -->
  <section class="section section-surface reveal" id="audiences">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Tailored Solutions</span>
        <h2>Who uses SQUARES Vault?</h2>
        <p>Specific life-admin setups designed around real household pain points.</p>
      </div>

      <div class="audiences-grid-custom">
        {audiences.map((aud) => (
          <div class="audience-card-custom">
            <div>
              <h3>
                <a href={getAssetUrl(`/for/${aud.slug}/`)}>
                  {aud.title}
                </a>
              </h3>
              <p>
                {aud.subtitle}
              </p>
            </div>
            <a href={getAssetUrl(`/for/${aud.slug}/`)} style="font-size: 14px; font-weight: 600;">
              <span>Read solution guide →</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════ 8. TESTIMONIALS (CONDITIONAL) ═══════════════════ -->
  <Testimonials />

  <!-- ═══════════════════ 9. FAQ ACCORDION ═══════════════════ -->
  <section class="section reveal" id="faq">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Common Inquiries</span>
        <h2>Frequently Asked Questions</h2>
        <p>Direct answers about permissions, Google Gemini API handling, and security.</p>
      </div>

      <FaqAccordion items={homeFaqs} />
    </div>
  </section>

  <!-- ═══════════════════ 10. FINAL CALL TO ACTION (Dark Contrast) ═══════════════════ -->
  <section class="section section-dark final-cta-custom reveal">
    <div class="container text-container">
      <h2>Take control of your household life-admin.</h2>
      <p>
        Request your free invite code to start organizing your vital documents in Telegram.
      </p>

      <div style="display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; margin-bottom: 24px;">
        <a href={siteConfig.inviteEmailUrl} class="btn-dark">
          <span>Request Free Invite Code</span>
        </a>
      </div>

      <div style="font-size: 13.5px; color: #8e8e93; line-height: 1.6;">
        {siteConfig.inviteNotice} · {siteConfig.pricingNotice} · Zero server file custody
      </div>
    </div>
  </section>
</BaseLayout>

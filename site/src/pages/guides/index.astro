---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig, getAssetUrl } from '../../config';
import guides from '../../data/guides.json';
import LucideIcon from '../../components/icons/LucideIcon.astro';

const title = 'Document Management Guides & Expiry Checklists | SQUARES Vault';
const description = 'Practical, step-by-step guides on tracking vehicle RC and PUC expiry, renewing car insurance, organising appliance warranty receipts, and sharing family documents safely.';
---

<BaseLayout title={title} description={description} canonicalPath="/guides/">
  <div class="container" style="padding: 40px 0 80px;">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" style="font-size: 0.85rem; color: var(--ink-muted); margin-bottom: 24px;">
      <a href={getAssetUrl('/')} style="color: var(--ink-secondary); text-decoration: none;">Home</a>
      <span style="margin: 0 8px;">/</span>
      <span style="color: var(--ink-primary); font-weight: 500;">Guides</span>
    </nav>

    <!-- Header Block -->
    <header style="margin-bottom: 48px; padding-bottom: 28px; border-bottom: 1px solid var(--border-hairline);">
      <h1 style="margin-bottom: 14px;">Guides & Checklists</h1>
      <p style="font-size: 1.18rem; color: var(--ink-secondary); max-width: var(--text-max-width);">
        Factual, straightforward routines for managing vehicle papers, appliance warranties, insurance renewals, and household administration in India.
      </p>
    </header>

    <div style="display: grid; grid-template-columns: 1fr 340px; gap: 48px; align-items: start;">
      <!-- Guides List -->
      <div style="display: flex; flex-direction: column; gap: 24px;">
        {guides.map((guide) => (
          <article style="background-color: var(--surface); border-radius: var(--radius-card); padding: 32px; display: flex; flex-direction: column; gap: 12px;">
            <div style="display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--muted);">
              <span class="badge-status active">{guide.category}</span>
              <span>·</span>
              <span>{guide.readTime}</span>
              <span>·</span>
              <span>Published {guide.publishedDate}</span>
            </div>

            <h2 style="font-size: 24px; margin: 0; line-height: 1.3;">
              <a href={getAssetUrl(`/guides/${guide.slug}/`)} style="color: var(--text); text-decoration: none;">
                {guide.title}
              </a>
            </h2>

            <p style="font-size: 16px; color: var(--muted); line-height: 1.55; margin: 0;">
              {guide.summary}
            </p>

            <div style="margin-top: 10px;">
              <a href={getAssetUrl(`/guides/${guide.slug}/`)} class="link-apple">
                <span>Read Full Guide</span>
                <span class="chevron">›</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Sidebar -->
      <aside style="position: sticky; top: 70px; display: flex; flex-direction: column; gap: 24px;">
        <div style="background-color: var(--surface); border-radius: var(--radius-card); padding: 28px;">
          <strong style="color: var(--text); font-size: 16px; display: block; margin-bottom: 8px;">
            Automate with SQUARES Vault
          </strong>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.5; margin-bottom: 20px;">
            Instead of tracking dates on wall calendars, forward your documents to our Telegram assistant. Expiry reminders run on your schedule, and original files live in your Google Drive.
          </p>
          <a href={siteConfig.inviteEmailUrl} class="btn-apple-primary" style="width: 100%; margin-bottom: 12px; font-size: 15px; padding: 10px 18px;">
            <span>Request Invite Code</span>
          </a>
          <div style="text-align: center; margin-bottom: 12px;">
            <a href={siteConfig.botUrl} target="_blank" rel="noopener noreferrer" class="link-apple" style="font-size: 13px;">
              <span>Open in Telegram</span>
              <span class="chevron">›</span>
            </a>
          </div>
          <div style="font-size: 12px; color: var(--muted); text-align: center; line-height: 1.4;">
            {siteConfig.inviteNotice} · {siteConfig.pricingNotice}
          </div>
        </div>

        <div style="background-color: var(--surface); border-radius: var(--radius-card); padding: 24px;">
          <h3 style="font-size: 15px; margin-bottom: 12px;">Browse by Document Type</h3>
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; font-size: 14px;">
            <li><a href={getAssetUrl('/documents/vehicle-rc/')} class="link-apple"><span>Vehicle Registration Guide</span> <span class="chevron">›</span></a></li>
            <li><a href={getAssetUrl('/documents/puc-certificate/')} class="link-apple"><span>Inspection Certificate Tracker</span> <span class="chevron">›</span></a></li>
            <li><a href={getAssetUrl('/documents/car-insurance/')} class="link-apple"><span>Car Insurance Policy</span> <span class="chevron">›</span></a></li>
            <li><a href={getAssetUrl('/documents/extended-warranty/')} class="link-apple"><span>Extended Warranties</span> <span class="chevron">›</span></a></li>
            <li><a href={getAssetUrl('/documents/appliance-invoices/')} class="link-apple"><span>Appliance Invoices &amp; Bills</span> <span class="chevron">›</span></a></li>
            <li><a href={getAssetUrl('/documents/passport/')} class="link-apple"><span>Passport Expiry &amp; Renewals</span> <span class="chevron">›</span></a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
@media (max-width: 900px) {
  div[style*="grid-template-columns: 1fr 340px"] {
    grid-template-columns: 1fr !important;
  }
}
</style>

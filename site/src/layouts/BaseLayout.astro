---
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalPath?: string;
  type?: 'website' | 'article';
  currentLang?: 'en' | 'hi';
  jsonLd?: Record<string, any>;
  hreflangHi?: string;
  hreflangEn?: string;
}

const {
  title,
  description,
  ogImage,
  canonicalPath,
  type = 'website',
  currentLang = 'en',
  jsonLd,
  hreflangHi,
  hreflangEn,
} = Astro.props;
---

<!DOCTYPE html>
<html lang={currentLang}>
  <head>
    <SeoHead
      title={title}
      description={description}
      ogImage={ogImage}
      canonicalPath={canonicalPath}
      type={type}
      jsonLd={jsonLd}
      hreflangHi={hreflangHi}
      hreflangEn={hreflangEn}
    />
  </head>
  <body>
    <Header currentLang={currentLang} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

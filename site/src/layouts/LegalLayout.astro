---
import BaseLayout from './BaseLayout.astro';
import { getAssetUrl } from '../config';

interface Props {
  title: string;
  description: string;
  version: string;
  effectiveDate: string;
  canonicalPath: string;
}

const { title, description, version, effectiveDate, canonicalPath } = Astro.props;
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath}>
  <div class="container" style="max-width: 860px; margin: 0 auto; padding: 48px 0 80px;">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" style="font-size: 13px; color: var(--muted); margin-bottom: 24px;">
      <a href={getAssetUrl('/')} style="color: var(--muted); text-decoration: none;">Home</a>
      <span style="margin: 0 8px;">/</span>
      <span style="color: var(--text); font-weight: 500;">{title}</span>
    </nav>

    <header style="margin-bottom: 40px; padding-bottom: 24px; border-bottom: 1px solid var(--hairline);">
      <h1 style="font-size: clamp(32px, 5vw, 48px); margin-bottom: 12px;">{title}</h1>
      <div style="font-size: 13px; color: var(--muted);">
        <strong>Version:</strong> {version} &nbsp;|&nbsp;
        <strong>Effective Date:</strong> {effectiveDate} &nbsp;|&nbsp;
        <strong>Scope:</strong> Global (including India DPDP Act 2023, EU/UK GDPR, California CCPA)
      </div>
    </header>

    <div class="legal-body" style="font-size: 16px; line-height: 1.65;">
      <slot />
    </div>
  </div>
</BaseLayout>

<style is:global>
.legal-body h2 {
  font-size: 22px;
  font-weight: 600;
  margin: 40px 0 14px;
  color: var(--text);
  border-bottom: 1px solid var(--hairline);
  padding-bottom: 8px;
}
.legal-body h3 {
  font-size: 18px;
  font-weight: 600;
  margin: 28px 0 10px;
}
.legal-body p {
  margin-bottom: 16px;
  color: var(--text);
}
.legal-body ul, .legal-body ol {
  margin: 0 0 20px 24px;
  color: var(--text);
}
.legal-body li {
  margin-bottom: 8px;
}
.legal-body .doc-callout {
  background-color: var(--surface);
  border-radius: var(--radius-sm);
  padding: 20px 24px;
  margin: 28px 0;
  border-left: 3px solid var(--accent);
}
.legal-body .doc-callout.warning {
  border-left-color: var(--warn);
}
.legal-body table {
  width: 100%;
  border-collapse: collapse;
  margin: 28px 0;
  background-color: var(--surface);
  border-radius: var(--radius-sm);
  font-size: 14px;
  overflow: hidden;
}
.legal-body th, .legal-body td {
  padding: 14px 18px;
  border-bottom: 1px solid var(--hairline);
  text-align: left;
}
.legal-body th {
  background-color: #ebebee;
  font-weight: 600;
  color: var(--text);
}
</style>

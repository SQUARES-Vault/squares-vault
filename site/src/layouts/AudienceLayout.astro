---
import BaseLayout from './BaseLayout.astro';
import { siteConfig, getAssetUrl } from '../config';
import documents from '../data/documents.json';
import LucideIcon from '../components/icons/LucideIcon.astro';

interface Props {
  audience: any;
}

const { audience: aud } = Astro.props;

// Filter matching essential documents
const matchedDocs = documents.filter((d) => aud.essentialDocuments.includes(d.slug));
---

<BaseLayout
  title={`${aud.title} — Life-Admin & Document Management | SQUARES Vault`}
  description={aud.subtitle}
  canonicalPath={`/for/${aud.slug}/`}
>
  <div class="container" style="padding: 48px 0 80px;">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" style="font-size: 13px; color: var(--muted); margin-bottom: 24px;">
      <a href={getAssetUrl('/')} style="color: var(--muted); text-decoration: none;">Home</a>
      <span style="margin: 0 8px;">/</span>
      <span style="color: var(--muted);">Audiences</span>
      <span style="margin: 0 8px;">/</span>
      <span style="color: var(--text); font-weight: 500;">{aud.title}</span>
    </nav>

    <!-- Header Block -->
    <header style="margin-bottom: 48px; padding-bottom: 24px; border-bottom: 1px solid var(--hairline);">
      <h1 style="font-size: clamp(32px, 5vw, 56px); margin-bottom: 14px;">{aud.title}</h1>
      <p style="font-size: 19px; color: var(--muted); max-width: var(--text-max-width); line-height: 1.45;">
        {aud.subtitle}
      </p>
    </header>

    <div style="display: grid; grid-template-columns: 1fr 340px; gap: 48px; align-items: start;">
      <!-- Main Content -->
      <article class="text-container">
        <!-- The Core Problem -->
        <section style="margin-bottom: 40px;">
          <h2 style="font-size: 24px; margin-bottom: 12px;">The Core Problem</h2>
          <p style="font-size: 17px; color: var(--text); line-height: 1.5;">{aud.coreProblem}</p>
        </section>

        <!-- How SQUARES Vault Helps -->
        <section style="margin-bottom: 44px;">
          <h2 style="font-size: 24px; margin-bottom: 16px;">How SQUARES Vault Solves This</h2>
          <div style="display: flex; flex-direction: column; gap: 16px;">
            {aud.howVaultHelps.map((h: any) => (
              <div style="background-color: var(--surface); border-radius: var(--radius-sm); padding: 24px 28px;">
                <strong style="color: var(--text); font-size: 18px; display: block; margin-bottom: 6px;">
                  {h.title}
                </strong>
                <p style="margin: 0; font-size: 15px; color: var(--muted); line-height: 1.55;">
                  {h.description}
                </p>
              </div>
            ))}
          </div>
        </section>

        <!-- Quote -->
        {aud.quote && (
          <section style="margin-bottom: 44px; background-color: var(--surface); padding: 24px 28px; border-radius: var(--radius-sm);">
            <p style="font-style: italic; font-size: 16px; color: var(--muted); margin: 0; line-height: 1.5;">
              "{aud.quote}"
            </p>
          </section>
        )}

        <!-- Essential Documents for this Audience -->
        <section style="margin-bottom: 40px;">
          <h2 style="font-size: 24px; margin-bottom: 16px;">Essential Documents to Add First</h2>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;">
            {matchedDocs.map((doc) => (
              <a href={getAssetUrl(`/documents/${doc.slug}/`)} style="text-decoration: none; color: inherit;">
                <div style="background-color: var(--surface); border-radius: var(--radius-sm); padding: 20px; height: 100%; transition: transform 180ms ease;">
                  <span class="badge-status active" style="margin-bottom: 8px;">{doc.category}</span>
                  <strong style="color: var(--text); display: block; font-size: 15px; margin-bottom: 6px;">{doc.name}</strong>
                  <span class="link-apple" style="font-size: 13px;">View Guide <span class="chevron">›</span></span>
                </div>
              </a>
            ))}
          </div>
        </section>
      </article>

      <!-- Sidebar Sticky Card -->
      <aside style="position: sticky; top: 70px;">
        <div style="background-color: var(--surface); border-radius: var(--radius-card); padding: 28px;">
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px; color: var(--accent);">
            <LucideIcon name="shield-check" size={20} />
            <strong style="color: var(--text); font-size: 15px;">Private Beta Access</strong>
          </div>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.5; margin-bottom: 20px;">
            Get started in 15 seconds. No separate app downloads. Your files stay in your own Google Drive.
          </p>

          <a href={siteConfig.inviteEmailUrl} class="btn-apple-primary" style="width: 100%; margin-bottom: 12px; font-size: 15px; padding: 10px 18px;">
            <span>Request Free Invite Code</span>
          </a>

          <div style="text-align: center; margin-bottom: 14px;">
            <a href={siteConfig.botUrl} target="_blank" rel="noopener noreferrer" class="link-apple" style="font-size: 13px;">
              <span>Open in Telegram</span>
              <span class="chevron">›</span>
            </a>
          </div>

          <div style="font-size: 12px; color: var(--muted); text-align: center; line-height: 1.4;">
            {siteConfig.inviteNotice} · {siteConfig.pricingNotice}
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
@media (max-width: 900px) {
  div[style*="grid-template-columns: 1fr 340px"] {
    grid-template-columns: 1fr !important;
  }
}
</style>

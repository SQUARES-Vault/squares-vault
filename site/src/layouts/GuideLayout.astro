---
import BaseLayout from './BaseLayout.astro';
import { siteConfig, getAssetUrl } from '../config';
import documents from '../data/documents.json';

interface Props {
  guide: any;
}

const { guide } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.title,
  description: guide.summary,
  author: {
    '@type': 'Person',
    name: siteConfig.builderName,
  },
  datePublished: '2026-10-10',
  publisher: {
    '@type': 'Organization',
    name: siteConfig.siteName,
  },
};

const relatedDocs = documents.filter((d) => (guide.relatedDocSlugs || []).includes(d.slug));
---

<BaseLayout
  title={`${guide.title} | SQUARES Vault Guide`}
  description={guide.summary}
  canonicalPath={`/guides/${guide.slug}/`}
  type="article"
  jsonLd={jsonLd}
>
  <div class="container container-subpage" style="padding: 40px 0 80px;">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" style="font-size: 13px; color: var(--muted); margin-bottom: 24px;">
      <a href={getAssetUrl('/')} style="color: var(--muted); text-decoration: none;">Home</a>
      <span style="margin: 0 8px;">/</span>
      <a href={getAssetUrl('/guides/')} style="color: var(--muted); text-decoration: none;">Guides</a>
      <span style="margin: 0 8px;">/</span>
      <span style="color: var(--text); font-weight: 500;">{guide.title}</span>
    </nav>

    <!-- Header Block -->
    <header style="margin-bottom: 40px; padding-bottom: 20px; border-bottom: 1px solid var(--hairline);">
      <div style="font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 12px;">
        {guide.readTime} · Practical Life-Admin Guide
      </div>
      <h1 style="font-size: clamp(30px, 4vw, 48px); margin-bottom: 12px;">{guide.title}</h1>
      <p style="font-size: 18px; color: var(--muted); line-height: 1.45;">
        {guide.summary}
      </p>
    </header>

    <div class="subpage-layout">
      <!-- Main Content -->
      <article class="subpage-main" style="font-size: 17px; line-height: 1.6;">
        <p style="font-size: 19px; color: var(--text); font-weight: 500; margin-bottom: 36px; border-left: 3px solid var(--accent); padding-left: 20px;">
          {guide.intro}
        </p>

        {guide.sections.map((sec: any) => (
          <section style="margin-bottom: 40px;">
            <h2 style="font-size: 24px; margin-bottom: 14px; color: var(--text);">{sec.heading}</h2>
            <div style="white-space: pre-line; color: var(--muted); font-size: 16px; line-height: 1.65;">
              {sec.content}
            </div>
          </section>
        ))}

        <!-- Next Steps Callout -->
        <section style="margin: 48px 0; background-color: var(--surface); border: 1px solid var(--hairline); border-radius: var(--radius-card); padding: 32px;">
          <h3 style="font-size: 20px; margin-bottom: 8px;">Automate this routine today</h3>
          <p style="font-size: 15px; color: var(--muted); margin-bottom: 20px;">
            Forward your papers to SQUARES Vault in Telegram. Gemini AI logs the expiry date, schedules notifications, and files the original securely to your Google Drive.
          </p>
          <a href={siteConfig.inviteEmailUrl} class="btn-primary" style="font-size: 15px; padding: 10px 20px;">
            <span>Request Free Invite Code</span>
          </a>
          <div style="font-size: 12px; color: var(--muted); margin-top: 8px;">
            {siteConfig.inviteNotice}
          </div>
        </section>

        <!-- Related Documents -->
        {relatedDocs.length > 0 && (
          <section style="margin-top: 40px;">
            <h3 style="font-size: 20px; margin-bottom: 16px;">Related Document Guides</h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px;">
              {relatedDocs.map((doc) => (
                <a href={getAssetUrl(`/documents/${doc.slug}/`)} style="text-decoration: none; color: inherit;">
                  <div style="background-color: var(--surface); border: 1px solid var(--hairline); border-radius: var(--radius-sm); padding: 16px;">
                    <span class="badge-status active" style="margin-bottom: 6px;">{doc.category}</span>
                    <strong style="display: block; font-size: 15px; color: var(--text); margin-top: 4px;">{doc.name}</strong>
                    <span class="link-apple" style="font-size: 13px; margin-top: 6px;">View Guide <span class="chevron">›</span></span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}
      </article>

      <!-- Sidebar -->
      <aside class="subpage-sidebar">
        <div style="background-color: var(--surface); border: 1px solid var(--hairline); border-radius: var(--radius-card); padding: 28px;">
          <strong style="color: var(--text); font-size: 16px; display: block; margin-bottom: 8px;">
            About SQUARES Vault
          </strong>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.5; margin-bottom: 20px;">
            Zero-custodian document management in Telegram. Your original files are stored exclusively in your personal Google Drive.
          </p>

          <a href={siteConfig.inviteEmailUrl} class="btn-primary" style="width: 100%; margin-bottom: 12px; font-size: 15px; padding: 10px 18px; text-align: center;">
            <span>Request Invite Code</span>
          </a>

          <div style="text-align: center; margin-bottom: 12px;">
            <a href={siteConfig.botUrl} target="_blank" rel="noopener noreferrer" class="link-apple" style="font-size: 13px;">
              <span>Open in Telegram</span>
              <span class="chevron">›</span>
            </a>
          </div>

          <div style="font-size: 12px; color: var(--muted); text-align: center; line-height: 1.4;">
            {siteConfig.inviteNotice} · {siteConfig.pricingNotice}
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

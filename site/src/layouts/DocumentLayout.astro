---
import BaseLayout from './BaseLayout.astro';
import { siteConfig, getAssetUrl } from '../config';
import LucideIcon from '../components/icons/LucideIcon.astro';

interface Props {
  document: any;
}

const { document: doc } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: doc.faqs.map((f: any) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---

<BaseLayout
  title={`${doc.name} — Validity, Expiry & Renewal Tracking | SQUARES Vault`}
  description={doc.summary}
  canonicalPath={`/documents/${doc.slug}/`}
  jsonLd={jsonLd}
>
  <div class="container" style="padding: 40px 0 70px;">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" style="font-size: 0.85rem; color: var(--ink-muted); margin-bottom: 24px;">
      <a href={getAssetUrl('/')} style="color: var(--ink-secondary); text-decoration: none;">Home</a>
      <span style="margin: 0 8px;">/</span>
      <span style="color: var(--ink-secondary);">Documents</span>
      <span style="margin: 0 8px;">/</span>
      <span style="color: var(--ink-primary); font-weight: 500;">{doc.name}</span>
    </nav>

    <!-- Header Block -->
    <header style="margin-bottom: 40px; padding-bottom: 24px; border-bottom: 1px solid var(--border-hairline);">
      <div style="display: inline-flex; align-items: center; gap: 6px; margin-bottom: 12px;">
        <span class="badge-status active">{doc.category}</span>
      </div>
      <h1 style="margin-bottom: 12px;">{doc.name}</h1>
      <p style="font-size: 1.15rem; color: var(--ink-secondary); max-width: var(--text-max-width);">
        {doc.summary}
      </p>
    </header>

    <div style="display: grid; grid-template-columns: 1fr 340px; gap: 48px; align-items: start;">
      <!-- Main Content -->
      <article class="text-container">
        <!-- What It Is -->
        <section style="margin-bottom: 36px;">
          <h2 style="font-size: 1.4rem; margin-bottom: 12px;">What It Is</h2>
          <p>{doc.whatItIs}</p>
        </section>

        <!-- Where People Lose It -->
        <section style="margin-bottom: 36px; background-color: var(--bg-paper); border: 1px solid var(--border-hairline); border-left: 3px solid var(--status-expiring); padding: 18px 22px; border-radius: 0 var(--radius-sm) var(--radius-sm) 0;">
          <strong style="color: var(--ink-primary); display: block; font-size: 1rem; margin-bottom: 6px;">
            Where people usually lose it:
          </strong>
          <p style="margin: 0; font-size: 0.94rem;">{doc.wherePeopleLoseIt}</p>
        </section>

        <!-- Critical Dates That Matter -->
        <section style="margin-bottom: 36px;">
          <h2 style="font-size: 1.4rem; margin-bottom: 14px;">Critical Dates That Matter</h2>
          <div style="display: flex; flex-direction: column; gap: 12px;">
            {doc.criticalDates.map((cd: any) => (
              <div class="card-paper">
                <strong style="color: var(--ink-primary); font-size: 1rem; display: block; margin-bottom: 4px;">
                  {cd.name}
                </strong>
                <p style="margin: 0; font-size: 0.92rem;">{cd.description}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- What SQUARES Vault Extracts -->
        <section style="margin-bottom: 36px;">
          <h2 style="font-size: 1.4rem; margin-bottom: 14px;">What SQUARES Vault Extracts</h2>
          <div class="card-paper" style="background-color: var(--bg-subtle);">
            <ul style="margin: 0 0 0 20px; color: var(--ink-secondary); font-size: 0.94rem; display: flex; flex-direction: column; gap: 8px;">
              {doc.whatVaultExtracts.map((item: string) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </section>

        <!-- How To Use -->
        <section style="margin-bottom: 40px;">
          <h2 style="font-size: 1.4rem; margin-bottom: 12px;">How to Store &amp; Track This Document</h2>
          <p>{doc.howToUse}</p>
        </section>

        <!-- Specific FAQs -->
        <section style="margin-bottom: 40px;">
          <h2 style="font-size: 1.4rem; margin-bottom: 16px;">Frequently Asked Questions</h2>
          <div style="display: flex; flex-direction: column; gap: 12px;">
            {doc.faqs.map((f: any) => (
              <details class="faq-item">
                <summary>{f.q}</summary>
                <div class="faq-content">
                  <p>{f.a}</p>
                </div>
              </details>
            ))}
          </div>
        </section>
      </article>

      <!-- Sidebar Sticky Card -->
      <aside style="position: sticky; top: 90px;">
        <div class="card-paper" style="padding: 24px; border: 1px solid var(--border-muted);">
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px; color: var(--accent-pine);">
            <LucideIcon name="shield-check" size={20} />
            <strong style="color: var(--ink-primary); font-size: 0.92rem;">Zero-Custodian Storage</strong>
          </div>
          <p style="font-size: 0.88rem; color: var(--ink-secondary); line-height: 1.5; margin-bottom: 16px;">
            Forward your {doc.name} to SQUARES Vault in Telegram. The original file goes straight to your personal Google Drive.
          </p>

          <a href={siteConfig.botUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="width: 100%; margin-bottom: 12px;">
            <span>Track in Telegram</span>
            <span>&rarr;</span>
          </a>

          <div style="font-size: 0.78rem; color: var(--ink-muted); text-align: center;">
            {siteConfig.pricingNotice}
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
@media (max-width: 900px) {
  div[style*="grid-template-columns: 1fr 340px"] {
    grid-template-columns: 1fr !important;
  }
}
</style>

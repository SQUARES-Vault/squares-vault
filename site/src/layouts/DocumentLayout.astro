---
import BaseLayout from './BaseLayout.astro';
import { siteConfig, getAssetUrl } from '../config';
import LucideIcon from '../components/icons/LucideIcon.astro';

interface Props {
  document: any;
}

const { document: doc } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: doc.faqs.map((f: any) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---

<BaseLayout
  title={`${doc.name} — Validity, Expiry & Renewal Tracking | SQUARES Vault`}
  description={doc.summary}
  canonicalPath={`/documents/${doc.slug}/`}
  jsonLd={jsonLd}
>
  <div class="container" style="padding: 48px 0 80px;">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" style="font-size: 13px; color: var(--muted); margin-bottom: 24px;">
      <a href={getAssetUrl('/')} style="color: var(--muted); text-decoration: none;">Home</a>
      <span style="margin: 0 8px;">/</span>
      <span style="color: var(--muted);">Documents</span>
      <span style="margin: 0 8px;">/</span>
      <span style="color: var(--text); font-weight: 500;">{doc.name}</span>
    </nav>

    <!-- Header Block -->
    <header style="margin-bottom: 48px; padding-bottom: 24px; border-bottom: 1px solid var(--hairline);">
      <div style="display: inline-flex; align-items: center; gap: 6px; margin-bottom: 14px;">
        <span class="badge-status active">{doc.category}</span>
      </div>
      <h1 style="font-size: clamp(32px, 5vw, 56px); margin-bottom: 14px;">{doc.name}</h1>
      <p style="font-size: 19px; color: var(--muted); max-width: var(--text-max-width); line-height: 1.45;">
        {doc.summary}
      </p>
    </header>

    <div style="display: grid; grid-template-columns: 1fr 340px; gap: 48px; align-items: start;">
      <!-- Main Content -->
      <article class="text-container">
        <!-- What It Is -->
        <section style="margin-bottom: 40px;">
          <h2 style="font-size: 24px; margin-bottom: 12px;">What It Is</h2>
          <p style="font-size: 17px; color: var(--text); line-height: 1.5;">{doc.whatItIs}</p>
        </section>

        <!-- Where People Lose It -->
        <section style="margin-bottom: 40px; background-color: var(--surface); border-radius: var(--radius-sm); padding: 22px 26px;">
          <strong style="color: var(--text); display: block; font-size: 16px; margin-bottom: 6px;">
            Where people usually lose it:
          </strong>
          <p style="margin: 0; font-size: 15px; color: var(--muted); line-height: 1.5;">{doc.wherePeopleLoseIt}</p>
        </section>

        <!-- Critical Dates That Matter -->
        <section style="margin-bottom: 40px;">
          <h2 style="font-size: 24px; margin-bottom: 16px;">Critical Dates That Matter</h2>
          <div style="display: flex; flex-direction: column; gap: 14px;">
            {doc.criticalDates.map((cd: any) => (
              <div style="background-color: var(--surface); border-radius: var(--radius-sm); padding: 20px 24px;">
                <strong style="color: var(--text); font-size: 16px; display: block; margin-bottom: 6px;">
                  {cd.name}
                </strong>
                <p style="margin: 0; font-size: 15px; color: var(--muted); line-height: 1.5;">{cd.description}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- What SQUARES Vault Extracts -->
        <section style="margin-bottom: 40px;">
          <h2 style="font-size: 24px; margin-bottom: 16px;">What SQUARES Vault Extracts</h2>
          <div style="background-color: var(--surface); border-radius: var(--radius-sm); padding: 22px 26px;">
            <ul style="margin: 0 0 0 20px; color: var(--text); font-size: 15px; display: flex; flex-direction: column; gap: 8px;">
              {doc.whatVaultExtracts.map((item: string) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </section>

        <!-- How To Use -->
        <section style="margin-bottom: 48px;">
          <h2 style="font-size: 24px; margin-bottom: 12px;">How to Store &amp; Track This Document</h2>
          <p style="font-size: 17px; color: var(--text); line-height: 1.5;">{doc.howToUse}</p>
        </section>

        <!-- Specific FAQs -->
        <section style="margin-bottom: 48px;">
          <h2 style="font-size: 24px; margin-bottom: 18px;">Frequently Asked Questions</h2>
          <div class="faq-accordion-stack">
            {doc.faqs.map((f: any) => (
              <details class="faq-apple-item">
                <summary>
                  <span class="faq-apple-question">{f.q}</span>
                  <svg class="faq-apple-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </summary>
                <div class="faq-apple-content">
                  <p>{f.a}</p>
                </div>
              </details>
            ))}
          </div>
        </section>
      </article>

      <!-- Sidebar Sticky Card -->
      <aside style="position: sticky; top: 70px;">
        <div style="background-color: var(--surface); border-radius: var(--radius-card); padding: 28px;">
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px; color: var(--accent);">
            <LucideIcon name="shield-check" size={20} />
            <strong style="color: var(--text); font-size: 15px;">Zero-Custodian Storage</strong>
          </div>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.5; margin-bottom: 20px;">
            Forward your {doc.name} to SQUARES Vault in Telegram. The original file goes straight to your personal Google Drive.
          </p>

          <a href={siteConfig.inviteEmailUrl} class="btn-apple-primary" style="width: 100%; margin-bottom: 12px; font-size: 15px; padding: 10px 18px;">
            <span>Request Free Invite Code</span>
          </a>

          <div style="text-align: center; margin-bottom: 14px;">
            <a href={siteConfig.botUrl} target="_blank" rel="noopener noreferrer" class="link-apple" style="font-size: 13px;">
              <span>Open in Telegram</span>
              <span class="chevron">›</span>
            </a>
          </div>

          <div style="font-size: 12px; color: var(--muted); text-align: center; line-height: 1.4;">
            {siteConfig.inviteNotice} · {siteConfig.pricingNotice}
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
@media (max-width: 900px) {
  div[style*="grid-template-columns: 1fr 340px"] {
    grid-template-columns: 1fr !important;
  }
}
</style>
